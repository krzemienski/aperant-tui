+# -- subtask 1-3: extended spec-coverage tests ---------------------------------
+
+# (a) Deeply nested headings: H2 > H3 > H4.
+DEEP_NESTED = """\
+## Libraries
+
+### Web Frameworks
+
+#### Routers
+
+- [chi](https://github.com/go-chi/chi) - Lightweight router.
+
+#### Middleware
+
+- [negroni](https://github.com/urfave/negroni) - Idiomatic middleware.
+
+### Databases
+
+- [pg](https://github.com/go-pg/pg) - PostgreSQL ORM.
+
+## Tools
+
+- [gofmt](https://pkg.go.dev/cmd/gofmt) - Formatter.
+"""
+
+def test_deep_nested_headings_parent_and_is_leaf():
+    parsed = parse_markdown(DEEP_NESTED)
+    by_name = {c.name: c for c in parsed.categories}
+
+    libs = by_name["Libraries"]
+    assert libs.level == 2 and libs.parent is None and libs.is_leaf is False
+
+    web = by_name["Web Frameworks"]
+    assert web.level == 3 and web.parent == "Libraries" and web.is_leaf is False
+
+    routers = by_name["Routers"]
+    assert routers.level == 4 and routers.parent == "Web Frameworks"
+    assert routers.is_leaf is True
+    assert [it.title for it in routers.items] == ["chi"]
+
+    mw = by_name["Middleware"]
+    assert mw.level == 4 and mw.parent == "Web Frameworks" and mw.is_leaf is True
+    assert [it.title for it in mw.items] == ["negroni"]
+
+    dbs = by_name["Databases"]
+    assert dbs.level == 3 and dbs.parent == "Libraries" and dbs.is_leaf is True
+    # A later same-level H3 does not keep Web Frameworks a leaf.
+    assert web.is_leaf is False
+    assert by_name["Tools"].is_leaf is True
+
