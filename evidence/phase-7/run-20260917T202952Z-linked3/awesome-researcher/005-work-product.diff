@@ -0,0 +1,305 @@
+"""Human-in-the-loop review decisions: model, on-disk store, and pure applier.
+
+This module is the file-based contract shared by the pipeline's review gate
+(``run_pipeline --review-mode``) and the TUI Review screen. The pipeline
+writes the initial auto decisions, the TUI rewrites them as the reviewer
+approves/rejects/edits each candidate and finally flips ``finalized``, and the
+gate proceeds once it observes that flag. The same file drives ``--attach``
+replays, so live and replayed runs share one persistence path with no
+cross-loop object passing.
+
+Everything here parses defensively in the style of ``tui/state.py``: a
+missing, null, or oddly-shaped field degrades to a sane default instead of
+raising inside a render or gate loop.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+from pathlib import Path
+from typing import Any
+
+from awesome_researcher.utils.helpers import read_json, write_json
+
+# Filename of the decision store inside a run directory.
+DECISIONS_FILENAME = "review_decisions.json"
+
+# Fields a reviewer may override on an edited candidate. Everything else in
+# the validated record is carried through untouched.
+EDITABLE_FIELDS: tuple[str, ...] = ("title", "description", "category")
+
+
+class DecisionStatus(str, Enum):
+    """Lifecycle of one candidate under review."""
+
+    APPROVED = "approved"
+    REJECTED = "rejected"
+    EDITED = "edited"
+    PENDING = "pending"
+
+
+def _as_str(value: Any, default: str = "") -> str:
+    try:
+        if value is None:
+            return default
+        return str(value)
+    except (TypeError, ValueError):
+        return default
+
+
+def _as_bool(value: Any, default: bool = False) -> bool:
+    if value is None:
+        return default
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, float)):
+        return bool(value)
+    text = _as_str(value).strip().lower()
+    if text in {"true", "1", "yes", "y", "finalized", "final"}:
+        return True
+    if text in {"false", "0", "no", "n", ""}:
+        return False
+    return default
+
+
+def _as_decision(value: Any) -> DecisionStatus:
+    """Coerce an arbitrary stored value into a DecisionStatus.
+
+    Legacy files written by ``main._write_review_decisions`` used
+    ``"accepted"`` for validator-approved candidates; map it onto APPROVED so
+    old runs still fold correctly. Anything unrecognized degrades to PENDING.
+    """
+
+    if isinstance(value, DecisionStatus):
+        return value
+    text = _as_str(value).strip().lower()
+    if text == "accepted":
+        return DecisionStatus.APPROVED
+    try:
+        return DecisionStatus(text)
+    except ValueError:
+        return DecisionStatus.PENDING
+
+
+def _as_edited(value: Any) -> dict[str, str] | None:
+    """Coerce the ``edited`` override payload into a plain str->str dict."""
+
+    if not isinstance(value, dict):
+        return None
+    return {str(k): _as_str(v) for k, v in value.items()}
+
+
+@dataclass(slots=True)
+class ReviewDecision:
+    """One reviewer decision about one candidate, identified by URL."""
+
+    url: str
+    title: str = ""
+    decision: DecisionStatus = DecisionStatus.PENDING
+    reason: str = ""
+    edited: dict[str, str] | None = None
+    reviewer: str = ""
+    decided_at: str = ""
+
+    def to_dict(self) -> dict[str, Any]:
+        """JSON-ready dict (decision serialized as its value string)."""
+
+        return {
+            "url": self.url,
+            "title": self.title,
+            "decision": self.decision.value,
+            "reason": self.reason,
+            "edited": dict(self.edited) if self.edited else None,
+            "reviewer": self.reviewer,
+            "decided_at": self.decided_at,
+        }
+
+    @classmethod
+    def from_dict(cls, data: Any) -> "ReviewDecision":
+        """Defensively rebuild a ReviewDecision; never raises."""
+
+        if not isinstance(data, dict):
+            return cls(url="")
+        return cls(
+            url=_as_str(data.get("url")),
+            title=_as_str(data.get("title")),
+            decision=_as_decision(data.get("decision")),
+            reason=_as_str(data.get("reason")),
+            edited=_as_edited(data.get("edited")),
+            reviewer=_as_str(data.get("reviewer")),
+            decided_at=_as_str(data.get("decided_at")),
+        )
+
+
+class DecisionStore:
+    """Read/write the ``<run_dir>/review_decisions.json`` envelope.
+
+    Envelope schema (v2)::
+
+        {"finalized": <bool>, "decisions": [<ReviewDecision dict>, ...]}
+
+    Legacy files are a bare ``[<decision dict>, ...]`` list; ``load()`` and
+    every other reader tolerate both shapes. All writes go through
+    ``helpers.write_json`` so updates land atomically (tmp + rename) and a
+    concurrent reader never observes a torn file.
+    """
+
+    def __init__(self, run_dir: str | Path) -> None:
+        self.path = Path(run_dir) / DECISIONS_FILENAME
+
+    # -- raw envelope ------------------------------------------------------
+
+    def _read_envelope(self) -> dict[str, Any]:
+        """Return the raw envelope dict; legacy lists and garbage degrade
+        gracefully to an empty, unfinalized envelope."""
+
+        raw = read_json(self.path, default=None)
+        if isinstance(raw, dict):
+            decisions = raw.get("decisions")
+            return {
+                "finalized": _as_bool(raw.get("finalized")),
+                "decisions": [d for d in decisions if isinstance(d, dict)]
+                if isinstance(decisions, list)
+                else [],
+            }
+        # Legacy bare-list file (written before the envelope existed).
+        if isinstance(raw, list):
+            return {
+                "finalized": False,
+                "decisions": [d for d in raw if isinstance(d, dict)],
+            }
+        return {"finalized": False, "decisions": []}
+
+    def _write_envelope(self, finalized: bool, decisions: list[dict[str, Any]]) -> None:
+        write_json(self.path, {"finalized": finalized, "decisions": decisions})
+
+    # -- public API ----------------------------------------------------------
+
+    def load(self) -> list[ReviewDecision]:
+        """All decisions in file order (later entries win on duplicate URLs)."""
+
+        return [
+            ReviewDecision.from_dict(d) for d in self._read_envelope()["decisions"]
+        ]
+
+    def is_finalized(self) -> bool:
+        """True once the reviewer has marked the review session complete."""
+
+        return _as_bool(self._read_envelope().get("finalized"))
+
+    def finalize(self) -> None:
+        """Flip ``finalized`` while preserving the current decisions."""
+
+        envelope = self._read_envelope()
+        self._write_envelope(True, envelope["decisions"])
+
+    def upsert_decision(self, decision: ReviewDecision) -> None:
+        """Insert or replace (by URL) one decision and write atomically."""
+
+        envelope = self._read_envelope()
+        record = decision.to_dict()
+        decisions = envelope["decisions"]
+        kept = [d for d in decisions if _as_str(d.get("url")) != decision.url]
+        kept.append(record)
+        # Keep stable file order for diffs; new record last is fine.
+        self._write_envelope(envelope["finalized"], kept)
+
+    def upsert_decisions(self, decisions: list[ReviewDecision]) -> None:
+        """Bulk upsert in one atomic write (order preserved, later wins)."""
+
+        envelope = self._read_envelope()
+        existing = envelope["decisions"]
+        by_url = {_as_str(d.get("url")): d for d in existing if isinstance(d, dict)}
+        for decision in decisions:
+            by_url[decision.url] = decision.to_dict()
+        self._write_envelope(
+            envelope["finalized"], list(by_url.values())
+        )
+
+    def decisions_for(self, urls: list[str]) -> dict[str, ReviewDecision]:
+        """Map each requested URL to its latest decision (missing URLs absent)."""
+
+        wanted = {_as_str(u) for u in urls if _as_str(u)}
+        latest: dict[str, ReviewDecision] = {}
+        for decision in self.load():
+            if decision.url in wanted:
+                latest[decision.url] = decision
+        return latest
+
+    def pending_urls(self, validated_urls: list[str]) -> list[str]:
+        """URLs with no decision yet (or still PENDING), preserving input order."""
+
+        decided = {
+            d.url: d
+            for d in self.load()
+            if d.decision is not DecisionStatus.PENDING
+        }
+        pending: list[str] = []
+        seen: set[str] = set()
+        for url in validated_urls:
+            url = _as_str(url)
+            if not url or url in seen:
+                continue
+            seen.add(url)
+            if url not in decided:
+                pending.append(url)
+        return pending
+
+
+def apply_decisions(
+    validated: list[dict[str, Any]], decisions: list[ReviewDecision]
+) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
+    """Split validated candidates by reviewer decision. Pure; never raises.
+
+    Returns ``(approved_records, rejected_by_reviewer)``:
+
+    - ``approved_records``: copies of the validated dicts for every candidate
+      that is APPROVED, EDITED, or undecided. The gate's timeout fallback and
+      the approve-all shortcut both rely on undecided candidates passing
+      through. EDITED decisions override ``title``/``description``/``category``
+      from ``decision.edited`` (blank overrides are ignored).
+    - ``rejected_by_reviewer``: one ``{url, title, reason, decision}`` dict per
+      candidate the reviewer explicitly REJECTED, in validated order.
+
+    Input dicts are never mutated; edited overrides land on copies.
+    """
+
+    latest: dict[str, ReviewDecision] = {}
+    for decision in decisions or []:
+        if decision is not None and decision.url:
+            latest[decision.url] = decision
+
+    approved_records: list[dict[str, Any]] = []
+    rejected_by_reviewer: list[dict[str, Any]] = []
+
+    for record in validated or []:
+        if not isinstance(record, dict):
+            continue
+        url = _as_str(record.get("url"))
+        decision = latest.get(url)
+
+        if decision is not None and decision.decision is DecisionStatus.REJECTED:
+            rejected_by_reviewer.append(
+                {
+                    "url": url,
+                    "title": _as_str(record.get("title")) or decision.title,
+                    "reason": decision.reason or "reviewer.rejected",
+                    "decision": DecisionStatus.REJECTED.value,
+                }
+            )
+            continue
+
+        out = dict(record)
+        if (
+            decision is not None
+            and decision.decision is DecisionStatus.EDITED
+            and decision.edited
+        ):
+            for field_name in EDITABLE_FIELDS:
+                override = decision.edited.get(field_name)
+                if isinstance(override, str) and override.strip():
+                    out[field_name] = override
+        approved_records.append(out)
+
+    return approved_records, rejected_by_reviewer
