+"""Generate a Markdown pull-request body from run-directory artifacts.
+
+Like :mod:`report_generator`, this is synthesized purely from the JSON files
+already on disk (``run_manifest.json``, ``validated_links.json``,
+``rejected_links.json``, ``review_decisions.json``) so it can be regenerated
+at any time — live at the end of a run, or from an ``--attach`` replay after
+the reviewer edits decisions. Each section degrades to a placeholder when its
+source artifact is absent so the body is never an INTERNAL ERROR.
+
+Layout:
+  - summary line (approved / reviewer-rejected / edited / auto-rejected)
+  - ``## Reviewer decisions`` table (decision, title, url, reviewer reason)
+  - ``## Auto-rejected by validator`` table (url, reason), capped at 25 rows
+  - footer with the run id and artifact pointers
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import TYPE_CHECKING, Any
+
+from awesome_researcher.core.events import EventBus, EventType, make_event
+from awesome_researcher.core.review import DecisionStore, DecisionStatus, ReviewDecision
+from awesome_researcher.renderers.report_generator import _md_escape, _short, _table
+from awesome_researcher.utils.helpers import read_json
+
+if TYPE_CHECKING:
+    from awesome_researcher.config import Config
+
+# The auto-rejected table is capped so a noisy run cannot produce a
+# 500-row PR body; the overflow is summarized in a trailing note.
+_MAX_AUTO_REJECTED_ROWS = 25
+
+
+# ---------------------------------------------------------------------------
+# Pure body-building helpers (offline-testable, no I/O, no events).
+# ---------------------------------------------------------------------------
+
+
+def _decision_rows(
+    decisions: list[ReviewDecision],
+    validated: list[dict[str, Any]],
+) -> tuple[list[list[Any]], dict[str, int]]:
+    """Build the Reviewer-decisions table rows plus the summary counts.
+
+    Rows cover every candidate with an explicit decision (approved / edited /
+    reviewer-rejected) and every validated URL that never got one — those pass
+    through as approved (the gate's timeout fallback relies on the same rule)
+    and are labeled with an auto-approve note.
+    """
+
+    by_url: dict[str, dict[str, Any]] = {}
+    for record in validated or []:
+        if isinstance(record, dict):
+            url = str(record.get("url", "") or "")
+            if url:
+                by_url[url] = record
+
+    rows: list[list[Any]] = []
+    counts = {"approved": 0, "rejected": 0, "edited": 0}
+    seen: set[str] = set()
+
+    for decision in decisions or []:
+        if not decision.url or decision.url in seen:
+            continue
+        seen.add(decision.url)
+        record = by_url.get(decision.url, {})
+        title = decision.title or str(record.get("title", "") or "")
+        if decision.decision is DecisionStatus.REJECTED:
+            counts["rejected"] += 1
+            reason = decision.reason or "reviewer rejected"
+        elif decision.decision is DecisionStatus.EDITED:
+            counts["edited"] += 1
+            edited = decision.edited or {}
+            overrides = ", ".join(
+                f"{k}: {_short(str(v), 60)}" for k, v in sorted(edited.items()) if str(v).strip()
+            )
+            reason = decision.reason or (f"edited — {overrides}" if overrides else "edited")
+        else:
+            # APPROVED (legacy "accepted" maps here too); PENDING without an
+            # explicit rejection behaves as approved downstream, so label it.
+            counts["approved"] += 1
+            reason = decision.reason or (
+                "" if decision.decision is DecisionStatus.APPROVED else "no reviewer decision"
+            )
+        rows.append([decision.decision.value, _md_escape(_short(title, 60)), _md_escape(decision.url), _md_escape(_short(reason, 120))])
+
+    # Validated candidates the decisions file never mentioned.
+    for url, record in by_url.items():
+        if url in seen:
+            continue
+        counts["approved"] += 1
+        rows.append(
+            [
+                DecisionStatus.APPROVED.value,
+                _md_escape(_short(str(record.get("title", "") or ""), 60)),
+                _md_escape(url),
+                "no reviewer decision recorded",
+            ]
+        )
+
+    return rows, counts
+
+
+def _auto_rejected_rows(rejected: list[dict[str, Any]]) -> tuple[list[list[Any]], int]:
+    """Capped auto-rejected table rows plus the number of hidden overflow rows."""
+
+    rows: list[list[Any]] = []
+    for record in (rejected or [])[:_MAX_AUTO_REJECTED_ROWS]:
+        if not isinstance(record, dict):
+            continue
+        rows.append(
+            [
+                _md_escape(str(record.get("url", "") or "")),
+                _md_escape(_short(str(record.get("reason", "") or "unspecified"), 120)),
+            ]
+        )
+    overflow = max(0, len(rejected or []) - _MAX_AUTO_REJECTED_ROWS)
+    return rows, overflow
+
+
+# ---------------------------------------------------------------------------
+# The PR body generator.
+# ---------------------------------------------------------------------------
+
+
+@dataclass(slots=True)
+class PRData:
+    """Snapshot of the run artifacts the PR body needs.
+
+    Every field is optional; missing artifacts render as placeholders so the
+    body is always a valid Markdown document, never an exception.
+    """
+
+    run_manifest: dict[str, Any] = field(default_factory=dict)
+    validated: list[dict[str, Any]] = field(default_factory=list)
+    rejected: list[dict[str, Any]] = field(default_factory=list)
+    decisions: list[ReviewDecision] = field(default_factory=list)
+
+    @classmethod
+    def from_run_dir(cls, run_dir: str | Path) -> PRData:
+        """Read every optional artifact from a run directory; missing → default."""
+
+        root = Path(run_dir)
+        return cls(
+            run_manifest=read_json(root / "run_manifest.json", default={}) or {},
+            validated=read_json(root / "validated_links.json", default=[]) or [],
+            rejected=read_json(root / "rejected_links.json", default=[]) or [],
+            decisions=DecisionStore(root).load(),
+        )
+
+
+class PRBodyGenerator:
+    """Synthesize a Markdown PR body from a run directory.
+
+    The body is also written to disk via :meth:`write`, which emits an
+    ``ARTIFACT_WRITTEN`` event when an event bus is supplied.
+    """
+
+    def __init__(
+        self,
+        config: Config | None = None,
+        event_bus: EventBus | None = None,
+        run_id: str = "",
+    ) -> None:
+        self._config = config
+        self._event_bus = event_bus
+        self._run_id = run_id
+
+    # -- pure body builder ---------------------------------------------------
+
+    def build(self, data: PRData) -> str:
+        """Return the full Markdown PR body for the given data."""
+
+        run_id = str(data.run_manifest.get("run_id", "") or self._run_id or "(unknown run)")
+        decision_rows, counts = _decision_rows(data.decisions, data.validated)
+        auto_rows, overflow = _auto_rejected_rows(data.rejected)
+
+        lines: list[str] = [
+            f"# Awesome list update — {run_id}",
+            "",
+            f"{counts['approved']} approved / {counts['rejected']} reviewer-rejected / "
+            f"{counts['edited']} edited / {len(data.rejected)} auto-rejected by validator.",
+            "",
+            "## Reviewer decisions",
+            "",
+            _table(["Decision", "Title", "URL", "Reviewer reason"], decision_rows),
+            "",
+            "## Auto-rejected by validator",
+            "",
+            _table(["URL", "Reason"], auto_rows),
+            "",
+        ]
+        if overflow > 0:
+            lines.append(f"_…and {overflow} more auto-rejected links omitted (see `rejected_links.json`)._")
+            lines.append("")
+        lines.extend(
+            [
+                "---",
+                "",
+                f"- **Run**: `{_md_escape(run_id)}`",
+                "- **Artifacts**: `validated_links.json`, `rejected_links.json`, "
+                "`review_decisions.json`, `research_report.md`",
+                "",
+            ]
+        )
+        return "\n".join(lines)
+
+    # -- I/O path with observability ----------------------------------------
+
+    async def write(self, run_dir: str | Path, data: PRData | None = None) -> Path:
+        """Build (or accept) a body and write it to ``pr_body.md``."""
+
+        root = Path(run_dir)
+        root.mkdir(parents=True, exist_ok=True)
+        if data is None:
+            data = PRData.from_run_dir(root)
+        body = self.build(data)
+        out = root / "pr_body.md"
+        out.write_text(body, encoding="utf-8")
+        if self._event_bus is not None:
+            await self._event_bus.publish(
+                make_event(
+                    self._run_id,
+                    EventType.ARTIFACT_WRITTEN,
+                    "pr_body_generator",
+                    phase="render",
+                    message=f"wrote {out.name}",
+                    metadata={
+                        "path": str(out),
+                        "bytes": len(body),
+                    },
+                )
+            )
+        return out
+
+
+__all__ = [
+    "PRData",
+    "PRBodyGenerator",
+]
