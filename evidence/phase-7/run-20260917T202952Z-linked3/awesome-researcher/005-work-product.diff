+def _merged_review_decisions(
+    validated: list[dict[str, Any]], decisions: list[ReviewDecision]
+) -> list[ReviewDecision]:
+    """One decision per validated URL: the reviewer's verdict if present, else
+    an auto-approve record shaped like ``_write_review_decisions``' output.
+
+    Reviewer-signed decisions for URLs no longer in ``validated`` are preserved
+    verbatim so nothing the reviewer said is silently dropped. Unsigned
+    out-of-validated records are the validator's auto-reject seed (already
+    captured in ``rejected_links.json``) and are dropped so the review block
+    counts only what the reviewer actually decided.
+    """
+
+    by_url: dict[str, ReviewDecision] = {}
+    for d in decisions or []:
+        if d is not None and d.url:
+            by_url[d.url] = d
+    now = datetime.now(timezone.utc).isoformat()
+    merged: list[ReviewDecision] = []
+    seen: set[str] = set()
+    for record in validated or []:
+        if not isinstance(record, dict):
+            continue
+        url = str(record.get("url", "") or "")
+        if not url or url in seen:
+            continue
+        seen.add(url)
+        reviewer = by_url.get(url)
+        if reviewer is not None:
+            merged.append(reviewer)
+        else:
+            merged.append(
+                ReviewDecision(
+                    url=url,
+                    title=str(record.get("title", "") or ""),
+                    decision=DecisionStatus.APPROVED,
+                    reason=str(record.get("acceptance_reason", "") or "validator.accepted"),
+                    decided_at=now,
+                )
+            )
+    for url, d in by_url.items():
+        if url not in seen and d.reviewer:
+            merged.append(d)
+    return merged
+
+
+async def _run_review_gate(
+    *,
+    run_dir: Path,
+    validated: list[dict[str, Any]],
+    config: Config,
+    t0: float,
+    run_id: str,
+    bus: EventBus,
+    poll_interval: float = 0.5,
+) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+    """Interactive review gate: wait for the reviewer, then apply the decisions.
+
+    Polls ``<run_dir>/review_decisions.json`` every ``poll_interval`` seconds
+    until the reviewer flips ``finalized`` or the run's remaining wall-time
+    budget (``config.wall_time_seconds`` measured against ``t0``) is gone — a
+    timeout publishes a WARNING and proceeds with auto-approve.
+
+    Returns ``(approved_records, review_block)``: the validated candidates that
+    survived review (EDITED field overrides applied) and the payload for
+    ``manifest['review']`` (per-candidate decision records incl. reject
+    reasons). Extracted from ``run_pipeline`` so tests can drive the gate
+    against a temp run dir without the SDK pipeline.
+    """
+
+    await bus.publish(
+        make_event(
+            run_id,
+            EventType.PHASE_STARTED,
+            "main",
+            phase="review",
+            message="phase: review (waiting for reviewer decisions)",
+        )
+    )
+    store = DecisionStore(run_dir)
+    remaining = config.wall_time_seconds - (time.monotonic() - t0)
+    deadline = time.monotonic() + max(0.0, remaining)
+    finalized = False
+    while time.monotonic() <= deadline:
+        if store.is_finalized():
+            finalized = True
+            break
+        if time.monotonic() >= deadline:
+            break
+        await asyncio.sleep(min(poll_interval, max(0.05, deadline - time.monotonic())))
+    if not finalized:
+        # One last look — the reviewer may have finalized inside the final sleep.
+        finalized = store.is_finalized()
+
+    mode = "manual" if finalized else "timeout-auto-approve"
+    if not finalized:
+        await bus.publish(
+            make_event(
+                run_id,
+                EventType.WARNING,
+                "main",
+                message="review gate timed out; auto-approving undecided candidates",
+                metadata={"mode": mode, "wall_time_seconds": config.wall_time_seconds},
+            )
+        )
+
+    decisions = store.load()
+    approved_records, _rejected_by_reviewer = apply_decisions(validated, decisions)
+
+    # Rewrite the store with the merged verdicts (reviewer decisions first,
+    # auto-approve defaults for anything undecided) so pr_body.md and attach
+    # replays see the final decisions in the envelope format.
+    merged = _merged_review_decisions(validated, decisions)
+    store.upsert_decisions(merged)
+
+    approved_count = sum(
+        1 for d in merged if d.decision is not DecisionStatus.REJECTED and d.decision is not DecisionStatus.EDITED
+    )
+    edited_count = sum(1 for d in merged if d.decision is DecisionStatus.EDITED)
+    rejected_count = sum(1 for d in merged if d.decision is DecisionStatus.REJECTED)
+    review_block = {
+        "finalized": finalized,
+        "mode": mode,
+        "approved_count": approved_count,
+        "reviewer_rejected_count": rejected_count,
+        "edited_count": edited_count,
+        "decisions": [d.to_dict() for d in merged],
+    }
+    return approved_records, review_block
+
+
