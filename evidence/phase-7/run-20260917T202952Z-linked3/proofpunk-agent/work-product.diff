diff --git a/proofpunk_agent/state/reducers/policy.py b/proofpunk_agent/state/reducers/policy.py
new file mode 100644
index 0000000..e820c01
--- /dev/null
+++ b/proofpunk_agent/state/reducers/policy.py
@@ -0,0 +1,243 @@
+"""Session-policy reducer -- constraint accounting for the Gate Report.
+
+The shell may load a declarative ``--policy`` file (``proofpunk_agent.policy``)
+constraining a session: a turn cap, a tool-call cap, a write-path allowlist,
+and required hook verdicts. Enforcement lives in the app shell (the
+permission gate, the submission gate, the event pump); THIS reducer does no
+enforcement at all. It only projects the event log into the counters and
+the violation list the Performance screen renders and the Gate Report
+exports, so that "the session breached its policy" is a fact read off the
+recorded log, not a side-channel memory of the shell that happens to still
+be alive.
+
+Replay determinism (VG-P2 discipline)
+--------------------------------------
+This reducer is a pure function of ``(state, event)``. It never reads a
+clock, never calls the global ``random`` module, never mutates an argument,
+and never raises: the same log replayed through the same reducers must
+produce byte-identical state, and that property is only provable if every
+input comes from the events themselves. Consequences, applied below:
+
+- Every value this reducer consumes (``num_turns``, ``terminal_reason``,
+  ``rule``, ``detail``) is read from ``event.data`` with a type check, and
+  a malformed value degrades to "not recorded this event" rather than
+  raising -- a reducer that crashes on one bad event would make the whole
+  replay unrunnable, and a replay gap is exactly the silent-failure class
+  this product exists to catch.
+- The one clock read in this module, ``_now_iso``, lives inside
+  ``violation_event`` -- a FACTORY used by producers (the app shell)
+  BEFORE the event enters the log, never inside the fold. This is the same
+  split ``bridge/sdk.py`` uses with its own ``_now_iso``: producers stamp,
+  reducers fold. ``Event.at`` is "wall-clock for display only" per
+  ``events.py``; a producer-stamped timestamp carried through the fold
+  violates nothing.
+- ``seq`` is assigned by ``EventLog.append``, never chosen here; a
+  ``PolicyViolation`` recorded by this reducer carries the event's own
+  ``seq``/``at`` verbatim, so the Gate Report can point back at the exact
+  log entry that recorded the breach.
+
+Counter semantics
+-----------------
+``turns_used`` is a monotonic MAX of ``RESULT`` payloads' ``num_turns``,
+not a sum: ``ResultMessage.num_turns`` is the SDK's session-cumulative
+turn count (verified in ``bridge/sdk.py``'s ``_project_result``), so
+summing consecutive ``RESULT`` events would double-count every turn after
+the first. ``max`` over an append-ordered log is also stable under replay
+by construction. A missing, non-``int``, or zero ``num_turns`` leaves the
+counter unchanged (``0 or turns_used`` -- the SDK reports turns starting
+at 1; a 0 would add no information anyway).
+
+``session_ended``/``session_end_reason`` latch on
+``terminal_reason == "max_turns"`` and are never cleared by a later
+``RESULT``: the fold over an append-only log is history, and a session
+that hit the SDK-side cap cannot un-hit it. Only that one terminal reason
+is recorded here; other terminal reasons are the conversation screen's
+domain, not the policy report's.
+
+``tool_calls_used`` counts ``TOOL_STARTED`` events only. ``TOOL_FINISHED``
+is deliberately not folded: the cap the policy file declares is on calls
+the model issued, and a ``TOOL_STARTED`` without a matching ``TOOL_FINISHED``
+(a killed shell, a truncated log) was still a call the permission gate had
+to judge.
+
+``PolicyViolation`` rows are appended verbatim from ``POLICY_VIOLATION``
+events (rule/detail from ``data``, seq/at/subject from the event). The
+reducer does not judge severity or deduplicate: two recorded breaches are
+two rows, and the Gate Report says what the log says.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, replace
+from datetime import datetime, timezone
+from typing import Any, Mapping
+
+from proofpunk_agent.state.events import Event, EventKind
+
+__all__ = [
+    "PolicyViolation",
+    "PolicyState",
+    "EMPTY_POLICY_STATE",
+    "reduce_policy",
+    "violation_event",
+]
+
+#: The one ``terminal_reason`` this reducer latches on (see module
+#: docstring "Counter semantics"): the SDK stopped the session because the
+#: turn cap was reached -- the policy-relevant terminal cause.
+_MAX_TURNS_REASON = "max_turns"
+
+
+@dataclass(frozen=True)
+class PolicyViolation:
+    """One recorded session-policy breach (one Gate Report row).
+
+    ``seq`` and ``at`` are the ``POLICY_VIOLATION`` event's own log
+    position and stamp, carried verbatim so a report row can point back at
+    the log entry that recorded it. ``subject`` is whatever the producer
+    bound the breach to (a ``tool_use_id`` for write-scope and
+    tool-call-cap denials, the session id for turn-cap refusals, the hook
+    event id for verdict mismatches); ``""`` means the breach was
+    session-global.
+    """
+
+    seq: int
+    at: str
+    rule: str
+    detail: str
+    subject: str = ""
+
+
+@dataclass(frozen=True)
+class PolicyState:
+    """Policy accounting slice: usage counters plus the violation list.
+
+    ``turns_used``/``tool_calls_used`` are the denominators the
+    Performance screen renders next to each declared cap (``4/10``); the
+    shell's submission gate reads the same fields live. ``violations`` is
+    append-ordered by log position. All fields default to "nothing
+    happened yet", so ``EMPTY_POLICY_STATE`` is the identity of the fold.
+    """
+
+    turns_used: int = 0
+    tool_calls_used: int = 0
+    violations: tuple[PolicyViolation, ...] = ()
+    #: Latched when the SDK reported ``terminal_reason == "max_turns"``;
+    #: never cleared by later events (append-only history).
+    session_ended: bool = False
+    session_end_reason: str | None = None
+
+
+EMPTY_POLICY_STATE = PolicyState()
+
+
+def _string_of(data: Mapping[str, Any], key: str) -> str:
+    """Read ``data[key]`` as a display string. Only a genuine ``str``
+    value is accepted -- anything else (absent, ``None``, a number, a
+    dict) records as ``""`` rather than being stringified or raising; the
+    reducer never fabricates content the producer did not send."""
+    value = data.get(key)
+    return value if isinstance(value, str) else ""
+
+
+def _handle_result(state: PolicyState, event: Event) -> PolicyState:
+    """Fold a ``RESULT``: monotonic ``num_turns`` max plus the max_turns
+    latch (see module docstring "Counter semantics")."""
+    data = event.data
+
+    turns_used = state.turns_used
+    reported = data.get("num_turns")
+    # ``type(...) is int`` (not isinstance) so a stray ``True`` is not
+    # accepted as 1 -- the same bool-must-not-pass convention the policy
+    # loader applies. ``reported or turns_used`` for the 0/None cases.
+    if type(reported) is int and reported > turns_used:
+        turns_used = reported
+
+    session_ended = state.session_ended
+    session_end_reason = state.session_end_reason
+    if _string_of(data, "terminal_reason") == _MAX_TURNS_REASON:
+        session_ended = True
+        session_end_reason = _MAX_TURNS_REASON
+
+    return replace(
+        state,
+        turns_used=turns_used,
+        session_ended=session_ended,
+        session_end_reason=session_end_reason,
+    )
+
+
+def _handle_tool_started(state: PolicyState, event: Event) -> PolicyState:
+    """One ``TOOL_STARTED`` is one call against the declared tool-call
+    cap, whether or not a ``TOOL_FINISHED`` ever follows."""
+    return replace(state, tool_calls_used=state.tool_calls_used + 1)
+
+
+def _handle_policy_violation(state: PolicyState, event: Event) -> PolicyState:
+    """Append one ``PolicyViolation`` verbatim from the event (rule/detail
+    from ``data``; seq/at/subject from the event itself). No dedupe, no
+    severity ranking -- the report says what the log says."""
+    violation = PolicyViolation(
+        seq=event.seq,
+        at=event.at,
+        rule=_string_of(event.data, "rule"),
+        detail=_string_of(event.data, "detail"),
+        subject=event.subject,
+    )
+    return replace(state, violations=state.violations + (violation,))
+
+
+_HANDLERS = {
+    EventKind.RESULT: _handle_result,
+    EventKind.TOOL_STARTED: _handle_tool_started,
+    EventKind.POLICY_VIOLATION: _handle_policy_violation,
+}
+
+
+def reduce_policy(state: PolicyState, event: Event) -> PolicyState:
+    """Pure ``(state, event) -> state`` fold for policy accounting.
+
+    Every ``EventKind`` not in ``_HANDLERS`` is totally ignored -- this
+    function never raises on an unrecognized kind and never mutates its
+    arguments (``PolicyState`` is frozen; every handler returns a new
+    instance via ``replace``).
+    """
+    handler = _HANDLERS.get(event.kind)
+    if handler is None:
+        return state
+    return handler(state, event)
+
+
+# ---------------------------------------------------------------------------
+# Producer-side factory (NOT part of the fold -- see module docstring)
+# ---------------------------------------------------------------------------
+
+
+def _now_iso() -> str:
+    """Wall-clock ISO-8601 for ``Event.at``. Display only -- never used
+    for attribution (events.py docstring). Same contract as the bridge's
+    ``_now_iso``; duplicated here rather than imported so the state
+    package does not depend on the bridge (events flow bridge -> state,
+    never the reverse)."""
+    return datetime.now(timezone.utc).isoformat()
+
+
+def violation_event(rule: str, detail: str, subject: str = "") -> Event:
+    """Construct a shell-produced ``POLICY_VIOLATION`` ``Event`` for the
+    enforcement paths to inject into the pipeline (write-scope deny,
+    tool-call cap, turn cap, hook-verdict mismatch).
+
+    This is a producer-side constructor, not a reducer step: it reads a
+    clock (``_now_iso``) precisely because it runs BEFORE the event
+    enters the append-only log, exactly like every event the bridge
+    constructs. ``seq`` stays at its default; the log assigns it on
+    append. ``tier`` stays ``UNATTRIBUTED`` -- a policy breach is a fact
+    about the session the shell observed, not an SDK attribution this
+    producer could honestly claim.
+    """
+    return Event(
+        kind=EventKind.POLICY_VIOLATION,
+        at=_now_iso(),
+        subject=subject,
+        data={"rule": rule, "detail": detail},
+    )
