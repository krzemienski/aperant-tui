+    def write_gate_report_now(self) -> Path | None:
+        """Write the Gate Report into the evidence run the DRIVER named.
+
+        Same containment discipline as ``action_capture_evidence_screenshot``
+        and ``PerformanceScreen.action_export_snapshot``, applied to
+        ``PROOFPUNK_AGENT_GATE_DIR``: refuse rather than improvise. No cwd
+        fallback, no mkdir, realpath == lexical, the target must already be
+        a helper-created ``e2e-evidence/run-*`` containing ``.run-meta``,
+        and an existing ``gate-report-*.json`` is never overwritten. Every
+        refusal is a notification, not an exception, because the one
+        guaranteed caller is ``_shutdown`` -- a refused export must not
+        block quitting.
+
+        No policy loaded is also a refusal: the Gate Report exists to
+        record compliance with a DECLARED policy, and a report cut from
+        no policy would carry all-null constraints and verdict ``NOT_RUN``
+        -- bytes that assert nothing while looking like an artifact. The
+        flagless path stays byte-identical: it writes nothing anywhere.
+
+        Returns the written path, or ``None`` on any refusal, so a driver
+        can assert on the outcome without scraping notifications.
+        """
+        import os
+        import sys
+        import time
+        from pathlib import Path
+
+        if self.policy is None:
+            self.notify("gate report: no policy loaded; nothing to report")
+            return None
+
+        raw_dir = os.environ.get("PROOFPUNK_AGENT_GATE_DIR", "").strip()
+        if not raw_dir:
+            self.notify("gate report: set PROOFPUNK_AGENT_GATE_DIR", severity="error")
+            return None
+
+        target = Path(raw_dir)
+        if not target.is_dir():
+            self.notify(f"gate report: {target} does not exist", severity="error")
+            return None
+        if target.resolve() != Path(os.path.abspath(target)):
+            self.notify("gate report: GATE_DIR has a symlink component", severity="error")
+            return None
+        if not target.name.startswith("run-") or target.parent.name != "e2e-evidence":
+            self.notify(
+                f"gate report: target must be e2e-evidence/run-*, got {target}",
+                severity="error",
+            )
+            return None
+        if not (target / ".run-meta").is_file():
+            self.notify(
+                f"gate report: {target} has no .run-meta (not a helper-created run)",
+                severity="error",
+            )
+            return None
+
+        name = f"gate-report-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}.json"
+        if (target / name).exists():
+            self.notify(
+                f"gate report: {name} already exists; refusing to overwrite",
+                severity="error",
+            )
