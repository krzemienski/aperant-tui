+    Absent constraints are omitted rather than rendered as ``None``: the
+    line exists to tell the operator what a session will be held to. A
+    document with nothing set spells that out as ``(no constraints)``
+    rather than printing nothing -- an empty line is indistinguishable
+    from a lookup that never ran.
+    """
+    parts: list[str] = []
+    if policy.max_turns is not None:
+        parts.append(f"max_turns={policy.max_turns}")
+    if policy.max_tool_calls is not None:
+        parts.append(f"max_tool_calls={policy.max_tool_calls}")
+    if policy.write_paths:
