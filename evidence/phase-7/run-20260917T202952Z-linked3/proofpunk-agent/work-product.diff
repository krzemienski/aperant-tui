diff --git a/validation/e2e/policy_gate.py b/validation/e2e/policy_gate.py
new file mode 100644
index 0000000..ed9f43b
--- /dev/null
+++ b/validation/e2e/policy_gate.py
@@ -0,0 +1,590 @@
+"""Session-policy gate driver -- all three --policy acceptance criteria.
+
+One script, three sections, one reproducible command for QA (the assignment
+for this feature asks for exactly that). Each section maps to one acceptance
+criterion and prints exactly one PASS line when it holds; any failed
+assertion prints a FAIL line naming the criterion before the script exits
+non-zero. The script is itself the artifact QA runs, so it never leaves
+scratch state behind: tempdirs and the gate-report run dir are removed in
+``finally`` blocks, and ``PROOFPUNK_AGENT_GATE_DIR`` is restored.
+
+Sections and their criteria:
+
+  1. FAIL-CLOSED (criterion 1 -- invalid/missing policy exits with a
+     structured error, code 2, before any session or UI starts). Launches
+     the real CLI as a subprocess -- ``python3 -m proofpunk_agent
+     --no-plugin --policy ... --check`` -- for the missing-file case and
+     three invalid documents (malformed JSON, unknown key, bad verdict),
+     then a valid document to prove ``--check`` still exits 0 WITH the
+     policy lines. One deliberate nuance, recorded here because the wire
+     contract has two halves by design (subtask-2-1): a MISSING file is
+     rejected at PARSE time by the argparse type-checker -- exit 2 with
+     argparse's ``policy file does not exist`` message -- while an invalid
+     DOCUMENT is rejected by ``load_policy`` -- exit 2 with a single JSON
+     line ``{"error": "policy", ...}`` on stderr. Both exit 2 before any
+     session or UI starts; only the second is JSON. This driver asserts
+     each half as implemented rather than papering over the split.
+
+  2. LOG + GATE REPORT (criterion 2 -- every enforcement path emits a
+     POLICY_VIOLATION event visible in the pump distribution and recorded
+     in the gate report payload). Drives the REAL app shell headlessly via
+     Textual's ``run_test`` pilot with a SYNTHETIC bridge standing in at
+     the SDK boundary: the shell's own ``_pump_events`` pulls a
+     PERMISSION_REQUESTED for a ``Write`` outside ``write_paths`` off the
+     bridge queue, the permission gate must auto-deny it in the same
+     handler turn (fail-closed ordering) and inject the POLICY_VIOLATION
+     back onto the SAME queue, the pump must fold it into the shell's
+     ``_policy_state``, ``gate_report_payload`` must carry it, and the
+     Screen 5 accessor must show it. The synthetic bridge is what makes
+     this runnable without credentials or a CLI child: it is a driver for
+     the SHELL's enforcement plumbing, not a claim about the SDK. The
+     subtask allows ``run_test`` or direct-component driving and asks that
+     the chosen path be recorded; this script prints which one it took.
+     The section closes with the gate report EXPORT through the real
+     containment path (``write_gate_report_now`` under
+     ``PROOFPUNK_AGENT_GATE_DIR``): a contained run dir writes a parseable
+     report, the same-second second call refuses (never overwrite), and an
+     unset env var refuses -- criterion 5's live behavior.
+
+  3. HUD/SCREEN (criterion 3 -- the performance screen renders the loaded
+     constraints and live usage, '(no policy loaded)' when the flag is
+     absent). One headless app WITH a policy: ``policy_lines()`` shows
+     every declared constraint with zeroed usage, a fed ``TOOL_STARTED``
+     ticks the usage row (``apply_event`` is the only ingress), and the
+     ``#perf-policy`` Static actually renders the block. One headless app
+     WITHOUT a policy: the explicit ``(no policy loaded)`` marker in both
+     the accessor and the rendered Static, and ``budget_lines()``
+     unchanged at its documented empty state -- the flagless path must
+     look exactly like the pre-feature screen.
+
+No ``pytest`` (there is none in this repo); plain asserts with messages,
+``try``/``except`` per section, a real process exit code at the end.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+# Direct execution (``python3 validation/e2e/policy_gate.py``) has no
+# package context, so relative imports are unavailable. Anchor the repo
+# root -- three parents up from this file (e2e/ -> validation/ -> root) --
+# exactly as the PTY scenario drivers resolve it, so ``proofpunk_agent``
+# and ``validation.capture`` (imported lazily by the gate report writer)
+# resolve identically here and under ``python -m``.
+_REPO_ROOT = Path(__file__).resolve().parents[2]
+if str(_REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(_REPO_ROOT))
+
+from claude_agent_sdk import PermissionResultAllow  # noqa: E402
+from textual.widgets import Static  # noqa: E402
+
+from proofpunk_agent.app import ProofpunkAgentApp  # noqa: E402
+from proofpunk_agent.gate_report import gate_report_payload  # noqa: E402
+from proofpunk_agent.policy import load_policy  # noqa: E402
+from proofpunk_agent.screens.performance import PerformanceScreen  # noqa: E402
+from proofpunk_agent.state.events import Event, EventKind  # noqa: E402
+
+__all__ = ["main"]
+
+
+# ---------------------------------------------------------------------------
+# Section scaffolding
+# ---------------------------------------------------------------------------
+
+
+def _report(name: str, ok: bool, detail: str) -> bool:
+    """Print one bracketed section line; returns ``ok`` unchanged so a
+    section body can end with ``return _report(...)``."""
+    print(f"[{'PASS' if ok else 'FAIL'}] {name}: {detail}")
+    return ok
+
+
+async def _poll(deadline_s: float, probe) -> None:
+    """Await ``probe()`` truthiness with a deadline -- the observe-before-
+    act rule the PTY drivers apply via ``wait_for``; never a bare
+    sleep-then-assert (the 2Hz Screen 5 tick means a fixed sleep that
+    happens to be long enough today is a timing bug tomorrow)."""
+    deadline = time.monotonic() + deadline_s
+    while time.monotonic() < deadline:
+        if probe():
+            return
+        await asyncio.sleep(0.05)
+    # One final probe so the failure is the assertion's, not the poll's.
+    if probe():
+        return
+    raise TimeoutError(f"condition not met within {deadline_s}s")
+
+
+def _run_cli(policy_arg: str) -> subprocess.CompletedProcess:
+    """Launch the real CLI exactly as an operator would for a --check."""
+    return subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "proofpunk_agent",
+            "--no-plugin",
+            "--policy",
+            policy_arg,
+            "--check",
+        ],
+        capture_output=True,
+        text=True,
+        timeout=60,
+        cwd=str(_REPO_ROOT),
+        env={**os.environ, "PYTHONPATH": str(_REPO_ROOT)},
+    )
+
+
+def _structured_error(proc: subprocess.CompletedProcess) -> dict:
+    """Assert the load-time failure contract: exit 2 plus ONE JSON line on
+    stderr whose ``error`` discriminator is ``policy``."""
+    assert proc.returncode == 2, (
+        f"expected exit 2, got {proc.returncode}; stderr={proc.stderr!r}"
+    )
+    try:
+        return json.loads(proc.stderr)
+    except ValueError as exc:
+        raise AssertionError(
+            f"stderr is not JSON-parseable ({exc}): {proc.stderr!r}"
+        ) from None
+
+
+# ---------------------------------------------------------------------------
+# Section 1 -- fail-closed CLI matrix (acceptance criterion 1)
+# ---------------------------------------------------------------------------
+
+
+def _section_fail_closed() -> bool:
+    tmp = Path(tempfile.mkdtemp(prefix="pp-policy-gate-s1-"))
+    try:
+        # (a) MISSING file: rejected at parse time by the argparse
+        # type-checker (subtask-2-1's design) -- exit 2, argparse's own
+        # message on stderr, and no --check output at all because main()
+        # never ran. That last part is the criterion's "before any session
+        # or UI starts" made observable.
+        missing = tmp / "absent.json"
+        proc = _run_cli(str(missing))
+        assert proc.returncode == 2, (
+            f"missing file: expected exit 2, got {proc.returncode}; "
+            f"stderr={proc.stderr!r}"
+        )
+        assert "policy file does not exist" in proc.stderr, (
+            f"missing file: argparse rejection not on stderr: {proc.stderr!r}"
+        )
+        assert "plugin root" not in proc.stdout, (
+            f"missing file: --check output ran anyway: {proc.stdout!r}"
+        )
+
+        # (b) MALFORMED JSON document.
+        bad_json = tmp / "malformed.json"
+        bad_json.write_text("{ not json", encoding="utf-8")
+        doc = _structured_error(_run_cli(str(bad_json)))
+        assert doc.get("error") == "policy", f"discriminator wrong: {doc!r}"
+        assert "malformed" in doc.get("reason", ""), f"reason wrong: {doc!r}"
+
+        # (c) UNKNOWN top-level key -- fail-closed vocabulary, not ignore.
+        unknown = tmp / "unknown-key.json"
+        unknown.write_text(json.dumps({"max_tuns": 3}), encoding="utf-8")
+        doc = _structured_error(_run_cli(str(unknown)))
+        assert doc.get("error") == "policy", f"discriminator wrong: {doc!r}"
+        assert doc.get("field") == "max_tuns", f"field wrong: {doc!r}"
+
+        # (d) BAD verdict value outside the allow/warn/block vocabulary.
+        verdict = tmp / "bad-verdict.json"
+        verdict.write_text(
+            json.dumps({"required_hook_verdicts": {"PreToolUse:Write": "maybe"}}),
+            encoding="utf-8",
+        )
+        doc = _structured_error(_run_cli(str(verdict)))
+        assert doc.get("error") == "policy", f"discriminator wrong: {doc!r}"
+        assert "verdict" in doc.get("field", ""), f"field wrong: {doc!r}"
+
+        # (e) VALID document: --check exits 0 and REPORTS the policy (the
+        # flag's happy path is visible, not silent).
+        valid = tmp / "valid.json"
+        valid.write_text(
+            json.dumps(
+                {
+                    "max_turns": 4,
+                    "max_tool_calls": 9,
+                    "write_paths": ["/tmp/pp-write-scope-probe"],
+                    "required_hook_verdicts": {"PreToolUse:Write": "block"},
+                }
+            ),
+            encoding="utf-8",
+        )
+        proc = _run_cli(str(valid))
+        assert proc.returncode == 0, (
+            f"valid policy: expected exit 0, got {proc.returncode}; "
+            f"stderr={proc.stderr!r}"
+        )
+        assert f"policy:      {valid}" in proc.stdout, (
+            f"valid policy: policy line missing: {proc.stdout!r}"
+        )
+        assert "constraints: max_turns=4 max_tool_calls=9" in proc.stdout, (
+            f"valid policy: constraints summary missing: {proc.stdout!r}"
+        )
+    except Exception as exc:
+        return _report(
+            "fail-closed CLI matrix",
+            False,
+            f"acceptance criterion 1 (invalid/missing policy exits 2, "
+            f"structured error, before any UI): {exc}",
+        )
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+    return _report(
+        "fail-closed CLI matrix",
+        True,
+        "missing file exit 2 (argparse); malformed/unknown-key/bad-verdict "
+        "exit 2 with JSON error=='policy'; valid --check exit 0 with the "
+        "policy line (criterion 1)",
+    )
+
+
+# ---------------------------------------------------------------------------
+# Section 2 -- enforcement -> log -> gate report (criterion 2)
+# ---------------------------------------------------------------------------
+
+
+class _SyntheticBridge:
+    """Queue-only stand-in for ``SdkBridge`` at the SDK boundary.
+
+    The assignment's alternative path ("drive the components directly")
+    allows the SDK boundary to be synthetic so this driver needs no
+    credentials and spawns no CLI child. What MUST stay real is everything
+    downstream of the queue: ``_pump_events`` fans the events out to the
+    live screens, folds the policy state, and routes
+    PERMISSION_REQUESTED into the real permission gate, whose deny path
+    injects the POLICY_VIOLATION back onto THIS queue -- so the breach
+    provably rides the same distribution everything else reads.
+
+    ``stop`` exists because app teardown (``on_unmount`` ->
+    ``_teardown_bridge``) awaits it; ``resolve_permission`` records the
+    verdict instead of settling an SDK future.
+    """
+
+    session_id = "synthetic-policy-gate"
+
+    def __init__(self) -> None:
+        self._queue: asyncio.Queue = asyncio.Queue()
+        self.injected: list[Event] = []
+        self.resolutions: list[tuple[str, str]] = []
+
+    async def events(self):
+        while True:
+            yield await self._queue.get()
+
+    def push(self, event: Event) -> None:
+        self._queue.put_nowait(event)
+
+    def inject(self, event: Event) -> None:
+        self.injected.append(event)
+        self._queue.put_nowait(event)
+
+    def resolve_permission(self, tool_use_id: str, result) -> bool:
+        behavior = "allow" if isinstance(result, PermissionResultAllow) else "deny"
+        self.resolutions.append((tool_use_id, behavior))
+        return True
+
+    async def stop(self) -> None:
+        return None
+
+
+async def _section_log_and_gate_report() -> bool:
+    # The drive path choice the subtask asks to record in the output.
+    print("drive path: run_test (Textual headless pilot, synthetic bridge)")
+    scratch = Path(tempfile.mkdtemp(prefix="pp-policy-gate-s2-"))
+    run_dir: Path | None = None
+    old_gate_dir = os.environ.get("PROOFPUNK_AGENT_GATE_DIR")
+    try:
+        allowed = scratch / "allowed"
+        allowed.mkdir()
+        outside_target = scratch / "outside" / "x.txt"
+        policy_path = scratch / "policy.json"
+        # A REAL load_policy, not a hand-built Policy: the loader resolves
+        # write_paths at load time (macOS resolve() rewrites /var and /tmp
+        # prefixes), and check_write resolves the target the same way --
+        # hand-constructing the Policy would bypass that anchoring.
+        policy_path.write_text(
+            json.dumps(
+                {
+                    "max_turns": 10,
+                    "max_tool_calls": 5,
+                    "write_paths": [str(allowed)],
+                    "required_hook_verdicts": {"PreToolUse:Write": "block"},
+                }
+            ),
+            encoding="utf-8",
+        )
+        policy = load_policy(policy_path)
+
+        app = ProofpunkAgentApp(policy=policy)
+        async with app.run_test(size=(120, 40)) as pilot:
+            # Install the synthetic bridge exactly as _ensure_bridge would
+            # (minus the SDK connect): pump task over bridge.events().
+            bridge = _SyntheticBridge()
+            app._bridge = bridge
+            app._pump = asyncio.create_task(app._pump_events(bridge))
+
+            # The out-of-scope Write request, plus a TOOL_STARTED and a
+            # RESULT so the counters fold beside the denial. The injected
+            # violation lands on the queue AFTER these (the deny happens
+            # while the pump is inside the PERMISSION_REQUESTED iteration),
+            # so the final state is the poll target below, never a fixed
+            # sleep.
+            bridge.push(
+                Event(
+                    kind=EventKind.PERMISSION_REQUESTED,
+                    at="2026-09-17T00:00:00Z",
+                    subject="toolu_policy_probe",
+                    data={
+                        "tool_name": "Write",
+                        "tool_input": {"file_path": str(outside_target)},
+                    },
+                )
+            )
+            bridge.push(
+                Event(
+                    kind=EventKind.TOOL_STARTED,
+                    at="2026-09-17T00:00:01Z",
+                    subject="toolu_policy_probe",
+                    data={"tool_name": "Write"},
+                )
+            )
+            bridge.push(
+                Event(
+                    kind=EventKind.RESULT,
+                    at="2026-09-17T00:00:02Z",
+                    data={"num_turns": 2},
+                )
+            )
+
+            state = await _wait_for_state(app)
+
+            # (a) Fail-closed denial: resolved deny in the same handler
+            # turn, one POLICY_VIOLATION injected into the shared queue,
+            # and no permission modal (the operator was never asked a
+            # question the policy had already answered).
+            assert bridge.resolutions == [("toolu_policy_probe", "deny")], (
+                f"expected one policy deny, got {bridge.resolutions!r}"
+            )
+            assert len(bridge.injected) == 1, (
+                f"expected exactly one injected violation, got "
+                f"{[e.kind for e in bridge.injected]!r}"
+            )
+            violation = bridge.injected[0]
+            assert violation.kind is EventKind.POLICY_VIOLATION, (
+                f"injected event is {violation.kind!r}, not POLICY_VIOLATION"
+            )
+            assert violation.data.get("rule") == "write_paths", (
+                f"violation rule is {violation.data.get('rule')!r}"
+            )
+            assert type(app.screen).__name__ != "PermissionModal", (
+                "permission modal was pushed for a policy-denied call"
+            )
+
+            # (b) The shell's fold counted it (this is the state the
+            # submission gate and the Gate Report read, not a screen copy).
+            assert state.tool_calls_used == 1, f"tool_calls_used={state.tool_calls_used}"
+            assert state.turns_used == 2, f"turns_used={state.turns_used}"
+            assert len(state.violations) == 1, (
+                f"violations={state.violations!r}"
+            )
+            row = state.violations[0]
+            assert row.rule == "write_paths" and row.subject == "toolu_policy_probe", (
+                f"violation row {row!r}"
+            )
+
+            # (c) The gate report payload carries it; verdict is honest.
+            payload = gate_report_payload(policy, state)
+            assert payload["verdict"] == "VIOLATIONS", payload["verdict"]
+            assert payload["turns_used"] == 2 and payload["tool_calls_used"] == 1
+            assert payload["violations"] and payload["violations"][0]["rule"] == "write_paths"
+            assert payload["policy"]["max_turns"] == 10
+            assert payload["policy"]["write_paths"] == list(policy.write_paths)
+
+            # (d) Screen 5's driver API shows constraint + violation count.
+            perf = app.query_one("#performance", PerformanceScreen)
+            lines = perf.policy_lines()
+            assert lines[0] == "POLICY", f"header line {lines[0]!r}"
+            assert any(l.strip().startswith("max_turns") and l.strip().endswith("2/10") for l in lines), lines
+            assert any(l.strip().startswith("max_tool_calls") and l.strip().endswith("1/5") for l in lines), lines
+            assert any(l.strip().startswith("write_paths") and policy.write_paths[0] in l for l in lines), lines
+            assert any("PreToolUse:Write<=block" in l for l in lines), lines
+            assert any(l.strip().startswith("violations") and l.strip().endswith("1") for l in lines), lines
+
+            # Gate report EXPORT through the real containment path. The run
+            # dir lives under the repo's own e2e-evidence (NOT a tempfile:
+            # macOS /tmp fails the realpath==lexical check by design) and
+            # carries the .run-meta marker the product demands.
+            evidence_root = _REPO_ROOT / "e2e-evidence"
+            assert evidence_root.is_dir(), f"missing {evidence_root}"
+            run_dir = evidence_root / f"run-policy-gate-{int(time.time())}-{os.getpid()}"
+            run_dir.mkdir(parents=True)
+            (run_dir / ".run-meta").write_text(
+                "driver: validation/e2e/policy_gate.py\n", encoding="utf-8"
+            )
+            os.environ["PROOFPUNK_AGENT_GATE_DIR"] = str(run_dir)
+
+            written = app.write_gate_report_now()
+            assert written is not None and written.is_file(), (
+                "contained gate report was not written"
+            )
+            on_disk = json.loads(written.read_text(encoding="utf-8"))
+            assert on_disk["verdict"] == "VIOLATIONS", on_disk.get("verdict")
+            assert any(v["rule"] == "write_paths" for v in on_disk["violations"]), on_disk
+            # Same-second second call: refused, never an overwrite. The
+            # two calls are back-to-back so the filename (second
+            # resolution) is identical by construction.
+            again = app.write_gate_report_now()
+            assert again is None, f"second same-second write returned {again!r}"
+            # Unset env: refusal, and nothing appears anywhere else.
+            del os.environ["PROOFPUNK_AGENT_GATE_DIR"]
+            assert app.write_gate_report_now() is None, "unset GATE_DIR wrote anyway"
+            await pilot.pause()
+    except Exception as exc:
+        return _report(
+            "log + gate report drive",
+            False,
+            f"acceptance criterion 2 (POLICY_VIOLATION visible in the pump "
+            f"and recorded in the gate report; criterion 5 export "
+            f"containment): {exc}",
+        )
+    finally:
+        if old_gate_dir is None:
+            os.environ.pop("PROOFPUNK_AGENT_GATE_DIR", None)
+        else:
+            os.environ["PROOFPUNK_AGENT_GATE_DIR"] = old_gate_dir
+        if run_dir is not None:
+            shutil.rmtree(run_dir, ignore_errors=True)
+        shutil.rmtree(scratch, ignore_errors=True)
+    return _report(
+        "log + gate report drive",
+        True,
+        "out-of-scope Write denied in-turn; POLICY_VIOLATION folded "
+        "(turns 2/10, calls 1/5, violations 1); payload verdict VIOLATIONS; "
+        "contained export wrote + refused overwrite + refused unset env "
+        "(criteria 2 and 5)",
+    )
+
+
+async def _wait_for_state(app: ProofpunkAgentApp):
+    """Poll the shell's own fold until the denial + counters all landed."""
+    await _poll(
+        10.0,
+        lambda: (
+            len(app._policy_state.violations) == 1
+            and app._policy_state.tool_calls_used == 1
+            and app._policy_state.turns_used == 2
+        ),
+    )
+    return app._policy_state
+
+
+# ---------------------------------------------------------------------------
+# Section 3 -- HUD / Screen 5 policy block (acceptance criterion 3)
+# ---------------------------------------------------------------------------
+
+
+async def _section_screen() -> bool:
+    tmp = Path(tempfile.mkdtemp(prefix="pp-policy-gate-s3-"))
+    try:
+        # (a) WITH a policy: constraints rendered, usage ticks via
+        # apply_event -- the screen's only ingress.
+        policy_path = tmp / "policy.json"
+        policy_path.write_text(
+            json.dumps({"max_turns": 4, "max_tool_calls": 50}), encoding="utf-8"
+        )
+        policy = load_policy(policy_path)
+        app = ProofpunkAgentApp(policy=policy)
+        async with app.run_test(size=(120, 40)):
+            perf = app.query_one("#performance", PerformanceScreen)
+            lines = perf.policy_lines()
+            assert lines[0] == "POLICY", lines
+            assert any(l.strip().startswith("max_turns") and l.strip().endswith("0/4") for l in lines), lines
+            assert any(l.strip().startswith("max_tool_calls") and l.strip().endswith("0/50") for l in lines), lines
+            assert any(l.strip().startswith("write_paths") and "(unrestricted)" in l for l in lines), lines
+            assert any(l.strip().startswith("hook verdicts") and "(none)" in l for l in lines), lines
+            assert any(l.strip().startswith("violations") and l.strip().endswith("0") for l in lines), lines
+
+            # apply_event is the sole ingress: one TOOL_STARTED must tick
+            # the usage row without any other wiring.
+            perf.apply_event(
+                Event(kind=EventKind.TOOL_STARTED, subject="toolu_s3", data={})
+            )
+            lines = perf.policy_lines()
+            assert any(l.strip().startswith("max_tool_calls") and l.strip().endswith("1/50") for l in lines), lines
+
+            # The rendered Static (not just the accessor) shows the block.
+            # #perf-policy paints on the screen's 2Hz tick, so poll.
+            static = app.query_one("#perf-policy", Static)
+            await _poll(5.0, lambda: "POLICY" in str(static.render()))
+            assert "0/4" in str(static.render()), str(static.render())
+
+        # (b) WITHOUT a policy (the flagless path): explicit marker, and
+        # the pre-feature budget behavior untouched.
+        bare = ProofpunkAgentApp()
+        async with bare.run_test(size=(120, 40)):
+            perf = bare.query_one("#performance", PerformanceScreen)
+            assert perf.policy_lines() == ["(no policy loaded)"], perf.policy_lines()
+            assert perf.budget_lines() == ["(no samples)"], perf.budget_lines()
+            static = bare.query_one("#perf-policy", Static)
+            await _poll(5.0, lambda: "(no policy loaded)" in str(static.render()))
+    except Exception as exc:
+        return _report(
+            "HUD/screen policy block",
+            False,
+            f"acceptance criterion 3 (constraints and live usage rendered; "
+            f"'(no policy loaded)' without the flag; budget lines "
+            f"unchanged): {exc}",
+        )
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+    return _report(
+        "HUD/screen policy block",
+        True,
+        "with policy: POLICY block, caps, apply_event usage tick, rendered "
+        "#perf-policy; without: '(no policy loaded)' and budget_lines "
+        "'(no samples)' unchanged (criterion 3)",
+    )
+
+
+# ---------------------------------------------------------------------------
+# Entry point
+# ---------------------------------------------------------------------------
+
+
+def main() -> int:
+    print("policy gate driver: 3 sections (fail-closed CLI, log+gate report, HUD)")
+    results: list[bool] = []
+
+    results.append(_section_fail_closed())
+    try:
+        results.append(asyncio.run(_section_log_and_gate_report()))
+    except Exception as exc:  # a section never crashes the driver
+        results.append(
+            _report("log + gate report drive", False, f"unhandled: {exc!r}")
+        )
+    try:
+        results.append(asyncio.run(_section_screen()))
+    except Exception as exc:
+        results.append(
+            _report("HUD/screen policy block", False, f"unhandled: {exc!r}")
+        )
+
+    passed = sum(1 for r in results if r)
+    print(f"\n{len(results)} sections: {passed} PASS, {len(results) - passed} FAIL")
+    return 0 if passed == len(results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
