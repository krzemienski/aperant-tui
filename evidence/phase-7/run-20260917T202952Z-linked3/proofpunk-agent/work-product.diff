index 0000000..a6a02f4
--- /dev/null
+++ b/proofpunk_agent/policy.py
@@ -0,0 +1,390 @@
+"""Session policy file (--policy): declarative constraints, fail-closed.
+
+A policy is a small JSON or YAML document an operator hands the CLI BEFORE a
+session starts, constraining it four ways:
+
+    max_turns              hard cap on assistant turns
+    max_tool_calls         hard cap on tool invocations
+    write_paths            allowlist of directory prefixes; write-class
+                           tools must stay inside one of them
+    required_hook_verdicts hook event type (e.g. ``PreToolUse:Write``)
+                           mapped to a required decision among
+                           allow/warn/block
+
+The load-time discipline mirrors ``__main__.py``'s plugin-root resolution:
+fail-closed, no fallthrough. An unreadable file, an unparseable document, a
+non-mapping root, an unknown top-level key, or a value of the wrong shape is
+a ``PolicyError`` -- never a warning, never a best-effort partial load. A
+policy that silently dropped the constraint it could not understand would be
+a cap that does not cap, exactly the defect class (``--max-budget`` parsed
+and never sent) this product documents elsewhere; rejecting unknown keys
+outright also keeps a future policy vocabulary honest -- a typo in
+``max_turns`` surfaces at launch, not as an uncapped session.
+
+Two rules that are easy to get wrong, both enforced here:
+
+  * The EMPTY document ``{}`` is a VALID policy -- no constraints. Absent
+    keys mean "unconstrained"; explicit ``null`` does NOT (it is present and
+    not an int, so it is rejected). "I impose nothing" and "I failed to say"
+    are different operator intents, and only the former is a document.
+
+  * Enforcement-time checks fail closed too. A write-class tool whose input
+    carries no extractable file path is a VIOLATION, not a pass: when
+    ``write_paths`` scopes writes, "cannot tell where it writes" must not
+    degrade into "assume it is fine".
+
+Everything in this module is pure data plumbing: parse, validate, and pure
+predicate helpers returning either ``None`` (allowed) or a structured
+``PolicyError`` describing the violation. Runtime enforcement lives in
+``app.py``; nothing here touches the SDK, the bridge, or the UI.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Mapping
+
+import yaml
+
+__all__ = [
+    "Policy",
+    "PolicyError",
+    "WRITE_TOOLS",
+    "HOOK_VERDICTS",
+    "load_policy",
+    "check_write",
+    "check_hook_verdict",
+]
+
+#: Tool classes whose effect is modifying files. Everything else (read-only
+#: tools, shell, search) is out of write-path scope by name: the allowlist
+#: gates what these tools may touch, not what other tools may do.
+WRITE_TOOLS = frozenset({"Write", "Edit", "NotebookEdit"})
+
+#: The closed vocabulary of hook decisions a ``required_hook_verdicts``
+#: value may demand (``PermissionResultAllow`` / ``...Warn`` / ``...Deny``
+#: as three strings).
+HOOK_VERDICTS = frozenset({"allow", "warn", "block"})
+
+#: The complete top-level vocabulary. Unknown keys are REJECTED, not
+#: ignored -- see the module docstring's fail-closed rationale.
+_POLICY_KEYS = frozenset(
+    {"max_turns", "max_tool_calls", "write_paths", "required_hook_verdicts"}
+)
+
+
+class PolicyError(Exception):
+    """A policy load failure or enforcement violation, as structured data.
+
+    ``path`` is the policy file for load-time errors, or the offending
+    target (``check_write``) / policy source (``check_hook_verdict``) for
+    enforcement-time ones; ``field`` names the policy key involved;
+    ``reason`` is human-readable. ``to_json()`` renders the exact shape the
+    CLI prints for a structured ``--policy`` error, so the wire format is
+    defined once, here, rather than reassembled at each print site.
+    """
+
+    def __init__(self, path: str, field: str, reason: str) -> None:
+        super().__init__(reason)
+        self.path = path
+        self.field = field
+        self.reason = reason
+
+    def to_json(self) -> dict:
+        return {"error": "policy", "path": self.path, "field": self.field, "reason": self.reason}
+
+    def __str__(self) -> str:
+        where = f"field {self.field!r} " if self.field else ""
+        return f"policy error: {where}{self.reason} (path: {self.path})"
+
+
+@dataclass(frozen=True)
+class Policy:
+    """Validated session constraints; immutable once loaded.
+
+    Every field is "absent = unconstrained" (``None`` / empty tuple / empty
+    mapping), so an enforcement site can short-circuit on falsiness without
+    a second flag -- and a session launched without ``--policy`` (where no
+    ``Policy`` exists at all) is behaviorally identical to one launched
+    with ``{}``. ``source`` records where the document came from (the
+    operator-passed path), carried for error attribution; it constrains
+    nothing.
+    """
+
+    max_turns: int | None = None
+    max_tool_calls: int | None = None
+    #: Directory prefixes (absolute strings; ``expanduser`` already applied
+    #: at load). A write is in scope iff its resolved target lies under --
+    #: or equals -- one of these.
+    write_paths: tuple[str, ...] = ()
+    #: Hook event type -> required decision. Keys absent from the document
+    #: impose nothing; keys present are audited by ``check_hook_verdict``.
+    required_hook_verdicts: Mapping[str, str] = field(default_factory=dict)
+    source: str = ""
+
+
+def _reject(path: str, field_name: str, reason: str) -> PolicyError:
+    return PolicyError(path=path, field=field_name, reason=reason)
+
+
+def _load_mapping(path: Path, text: str) -> Mapping:
+    """Parse ``text`` into a mapping, dispatching on suffix.
+
+    ``.json`` parses as JSON, ``.yaml``/``.yml`` as YAML. An extensionless
+    file is sniffed: JSON first (strict), then YAML -- JSON being (almost)
+    a YAML subset, JSON-first only affects which parse names the error when
+    the document is neither. Any OTHER suffix is rejected outright: a
+    ``.policy.txt`` that happened to parse would be a format nobody
+    declared, which is the quiet-substitution failure fail-closed exists
+    to prevent. A parse success that is not a mapping (YAML root list,
+    bare scalar) is likewise rejected -- a list of constraints has no
+    defined meaning.
+    """
+    suffix = path.suffix.lower()
+    parsed: object = None
+    if suffix == ".json":
+        try:
+            parsed = json.loads(text)
+        except ValueError as exc:
+            raise _reject(str(path), "", f"malformed JSON: {exc}") from None
+    elif suffix in (".yaml", ".yml"):
+        parsed = _safe_yaml(path, text)
+    elif suffix == "":
+        try:
+            parsed = json.loads(text)
+        except ValueError:
+            parsed = _safe_yaml(path, text)
+    else:
+        raise _reject(
+            str(path),
+            "",
+            f"unsupported policy file suffix {suffix!r} "
+            "(expected .json, .yaml, or .yml)",
+        )
+
+    if not isinstance(parsed, Mapping):
+        raise _reject(
+            str(path), "", f"policy root must be a mapping, got {type(parsed).__name__}"
+        )
+    return parsed
+
+
+def _safe_yaml(path: Path, text: str) -> object:
+    """``yaml.safe_load`` with a structured failure (never a raw traceback)."""
+    try:
+        return yaml.safe_load(text)
+    except yaml.YAMLError as exc:
+        raise _reject(str(path), "", f"malformed YAML: {exc}") from None
+
+
+def _validate_positive_int(path: str, key: str, value: object) -> int:
+    """``max_turns``/``max_tool_calls`` must be ints > 0.
+
+    ``type(value) is int`` rather than ``isinstance``: ``True`` IS an int
+    in Python, and JSON ``true`` parsed into a turn cap would otherwise
+    sail through as the cap ``1`` -- a silent constraint rewrite. Zero and
+    negatives are meaningless caps (a session allowed to do nothing is
+    expressed by not launching it), so they are rejected, not clamped.
+    """
+    if type(value) is not int:
+        raise _reject(str(path), key, f"{key} must be an int, got {type(value).__name__}")
+    if value <= 0:
+        raise _reject(str(path), key, f"{key} must be > 0, got {value}")
+    return value
+
+
+def _validate_write_paths(path: str, value: object) -> tuple[str, ...]:
+    """write_paths -> tuple of absolute-ish strings, expanduser applied.
+
+    Entries must be non-empty strings. Each is ``expanduser``-ed then
+    ``resolve()``-d to a string AT LOAD TIME -- anchored once, at the
+    operator's launch context, rather than re-resolved at every check
+    against whatever the process cwd happens to be mid-session. Relative
+    entries are therefore accepted but pinned to their load-time absolute
+    meaning; duplicates are preserved as written (harmless: containment is
+    an any-match over the tuple).
+    """
+    if not isinstance(value, (list, tuple)):
+        raise _reject(
+            str(path), "write_paths", f"write_paths must be a list, got {type(value).__name__}"
+        )
+    resolved: list[str] = []
+    for i, entry in enumerate(value):
+        if not isinstance(entry, str) or not entry.strip():
+            raise _reject(
+                str(path),
+                f"write_paths[{i}]",
+                f"write_paths entries must be non-empty strings, got {entry!r}",
+            )
+        resolved.append(str(Path(entry).expanduser().resolve()))
+    return tuple(resolved)
+
+
+def _validate_hook_verdicts(path: str, value: object) -> Mapping[str, str]:
+    """required_hook_verdicts -> mapping of event type -> allow/warn/block.
+
+    Keys must be non-empty strings (an empty event type could never match
+    an observed hook, so it would be a constraint that silently constrains
+    nothing). Values are checked against the closed ``HOOK_VERDICTS``
+    vocabulary -- an unknown verdict name would otherwise be a requirement
+    no hook decision could ever satisfy, or worse, one nothing bothers to
+    audit. Returns a plain dict copy: the document is read exactly once,
+    and nothing downstream can reach back into the file's parse tree.
+    """
+    if not isinstance(value, Mapping):
+        raise _reject(
+            str(path),
+            "required_hook_verdicts",
+            f"required_hook_verdicts must be a mapping, got {type(value).__name__}",
+        )
+    out: dict[str, str] = {}
+    for key, verdict in value.items():
+        if not isinstance(key, str) or not key:
+            raise _reject(
+                str(path),
+                "required_hook_verdicts",
+                f"keys must be non-empty hook event types, got {key!r}",
+            )
+        if verdict not in HOOK_VERDICTS:
+            raise _reject(
+                str(path),
+                f"required_hook_verdicts[{key}]",
+                f"verdict must be one of allow/warn/block, got {verdict!r}",
+            )
+        out[key] = verdict
+    return out
+
+
+def load_policy(path: str | Path) -> Policy:
+    """Load and validate a policy document; raise ``PolicyError`` otherwise.
+
+    Never returns a partial Policy: any single failure rejects the whole
+    document (no fallthrough), matching ``__main__.py``'s discipline that a
+    broken explicit choice aborts rather than sliding to an implicit one.
+    """
+    p = Path(path).expanduser()
+    if not p.is_file():
+        raise _reject(str(p), "", "policy file does not exist or is not a regular file")
+    try:
+        text = p.read_text(encoding="utf-8")
+    except OSError as exc:
+        raise _reject(str(p), "", f"policy file unreadable: {exc}") from None
+
+    root = _load_mapping(p, text)
+
+    for key in root:
+        if key not in _POLICY_KEYS:
+            raise _reject(
+                str(p),
+                str(key),
+                f"unknown top-level key {key!r} (fail-closed: policy vocabulary is "
+                f"{sorted(_POLICY_KEYS)})",
+            )
+
+    max_turns = (
+        _validate_positive_int(str(p), "max_turns", root["max_turns"])
+        if "max_turns" in root
+        else None
+    )
+    max_tool_calls = (
+        _validate_positive_int(str(p), "max_tool_calls", root["max_tool_calls"])
+        if "max_tool_calls" in root
+        else None
+    )
+    write_paths = (
+        _validate_write_paths(str(p), root["write_paths"])
+        if "write_paths" in root
+        else ()
+    )
+    hook_verdicts = (
+        _validate_hook_verdicts(str(p), root["required_hook_verdicts"])
+        if "required_hook_verdicts" in root
+        else {}
+    )
+
+    return Policy(
+        max_turns=max_turns,
+        max_tool_calls=max_tool_calls,
+        write_paths=write_paths,
+        required_hook_verdicts=hook_verdicts,
+        source=str(p),
+    )
+
+
+def _extract_write_target(tool_input: object) -> str | None:
+    """The path a write-class tool names, or None when none is extractable.
+
+    ``Write``/``Edit`` carry ``file_path``; ``NotebookEdit`` carries
+    ``notebook_path``. Both are consulted so the extraction does not encode
+    which tool is calling; anything that is not a non-empty string (absent
+    key, null, wrong type) extracts nothing -- and the caller treats that
+    as a violation, not a pass.
+    """
+    if not isinstance(tool_input, Mapping):
+        return None
+    for key in ("file_path", "notebook_path"):
+        value = tool_input.get(key)
+        if isinstance(value, str) and value:
+            return value
+    return None
+
+
+def check_write(policy: Policy, tool_name: str, tool_input: object) -> PolicyError | None:
+    """Pure write-scope predicate: None when allowed, else the violation.
+
+    Unconstrained policies (empty ``write_paths``) and non-write-class
+    tools pass unconditionally. For a scoped write, the target is resolved
+    the same way the allowlist was at load (``expanduser`` then
+    ``resolve``) and must lie under -- or equal -- some entry.
+    ``is_relative_to`` does prefix semantics correctly where naive string
+    ``startswith`` would not (``/tmp/evil`` does not lie under ``/tmp/e``
+    despite the string prefix). A write-class tool with NO extractable
+    path is a violation: fail-closed, per the module docstring.
+    """
+    if tool_name not in WRITE_TOOLS or not policy.write_paths:
+        return None
+
+    raw = _extract_write_target(tool_input)
+    if raw is None:
+        return _reject(
+            policy.source,
+            "write_paths",
+            f"{tool_name} carries no extractable file path; "
+            "cannot verify write scope (fail-closed)",
+        )
+
+    target = Path(raw).expanduser().resolve()
+    for prefix in policy.write_paths:
+        if target.is_relative_to(Path(prefix)):
+            return None
+    return _reject(
+        str(target),
+        "write_paths",
+        f"{tool_name} target lies outside every write_paths entry "
+        f"({', '.join(policy.write_paths)})",
+    )
+
+
+def check_hook_verdict(
+    policy: Policy, event_type: str, decision: object
+) -> PolicyError | None:
+    """Compare an observed hook decision against the policy's requirement.
+
+    Event types the policy does not mention impose nothing. A mentioned
+    type whose observed ``decision`` differs from the required verdict --
+    including a missing/None decision, which equals no verdict at all --
+    is a violation. Kept as a pure function so the pump can call it per
+    HOOK_EVENT and the loader tests can call it directly.
+    """
+    required = policy.required_hook_verdicts.get(event_type)
+    if required is None:
+        return None
+    if decision == required:
+        return None
+    return _reject(
+        policy.source,
+        "required_hook_verdicts",
+        f"{event_type} decision={decision}, required={required}",
+    )
