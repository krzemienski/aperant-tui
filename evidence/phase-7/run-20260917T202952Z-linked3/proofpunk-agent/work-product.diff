@@ -0,0 +1,121 @@
+"""Gate Report -- the policy-compliance artifact a session leaves behind.
+
+The Gate Report is the durable half of the ``--policy`` feature. Enforcement
+lives in ``app.py`` (the permission gate, the submission gate, the event
+pump) and every breach becomes a ``POLICY_VIOLATION`` event in the shared
+pipeline; THIS module is only the exporter that projects the folded
+``PolicyState`` -- the shell's authoritative counters -- into one JSON
+document an operator or a validator can read after the UI is gone.
+
+There is no pre-existing gate-report writer in this codebase to extend, so
+this module defines the artifact. Two disciplines from the rest of the
+product shape it:
+
+  * Never a false green. ``verdict`` is one of ``VIOLATIONS`` / ``CLEAN`` /
+    ``NOT_RUN`` -- never ``PASS`` on a session that was never measured.
+    ``PolicyState`` starts at zero counters and zero violations, and a
+    report cut from that state proves nothing: zero breaches over zero
+    turns is an empty set, not compliance. ``CLEAN`` is only claimed when
+    the fold actually observed activity (``turns_used > 0`` or
+    ``tool_calls_used > 0``); otherwise the report says ``NOT_RUN``. This
+    is the same branch order ``PerformanceScreen``'s ``_verdict`` applies
+    to an unsampled metric, for the same reason: a default-True boolean
+    rendered as a check is a false green.
+
+  * The report says what the log says. Constraints are copied verbatim
+    from the ``Policy`` (which the CLI validated fail-closed before the
+    session started); usage and violations are copied verbatim from the
+    ``PolicyState`` the shell folded from the event stream. Nothing here
+    re-counts, re-judges, or deduplicates -- a second implementation of
+    any of that could disagree with the reducer, and the report is
+    evidence, not opinion.
+
+Export target selection is deliberately NOT here. ``app.py``'s
+``write_gate_report_now`` owns the containment checks (env var, existing
+``e2e-evidence/run-*`` directory, ``.run-meta``, no overwrite) for the
+same reason ``PerformanceScreen.export_snapshot`` refuses to pick its own
+run: a writer that selects its own destination reintroduces the
+mtime-tie ambiguity ``fresh_evidence.py`` warns about.
+"""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+from proofpunk_agent.policy import Policy
+from proofpunk_agent.state.reducers.policy import PolicyState
+
+__all__ = ["gate_report_payload", "write_gate_report"]
+
+
+def gate_report_payload(
+    policy: Policy, policy_state: PolicyState, captured_at: str | None = None
+) -> dict:
+    """Build the Gate Report payload from a loaded policy and its fold.
+
+    ``captured_at`` defaults to a UTC ISO-8601 stamp read HERE, once -- a
+    plain data-assembly function may read a clock for the artifact's cover
+    stamp the way ``metrics_snapshot`` does; it is display metadata, never
+    attribution (the per-violation ``at`` values come verbatim from the
+    events that recorded them).
+    """
+    violations = [
+        {
+            "seq": v.seq,
+            "at": v.at,
+            "rule": v.rule,
+            "detail": v.detail,
+            "subject": v.subject,
+        }
+        for v in policy_state.violations
+    ]
+    if violations:
+        verdict = "VIOLATIONS"
+    elif policy_state.turns_used > 0 or policy_state.tool_calls_used > 0:
+        verdict = "CLEAN"
+    else:
+        verdict = "NOT_RUN"
+    return {
+        "captured_at": captured_at
+        or time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "policy": {
+            "source": policy.source,
+            "max_turns": policy.max_turns,
+            "max_tool_calls": policy.max_tool_calls,
+            "write_paths": list(policy.write_paths),
+            "required_hook_verdicts": dict(policy.required_hook_verdicts),
+        },
+        "turns_used": policy_state.turns_used,
+        "tool_calls_used": policy_state.tool_calls_used,
+        "violations": violations,
+        "verdict": verdict,
+    }
+
+
+def write_gate_report(
+    path: str | Path, policy: Policy, policy_state: PolicyState
+) -> Path:
+    """Write ``gate_report_payload`` as JSON to a CALLER-SUPPLIED path.
+
+    Same fallback discipline as ``PerformanceScreen.export_snapshot``:
+    ``validation.capture.write_json`` is preferred (its redaction is the
+    evidence path's), and if that helper is unavailable -- it belongs to a
+    validation harness, not a runtime dependency of the product -- a plain
+    sorted-keys JSON write happens rather than failing the export. Either
+    way the payload is identical; only the redaction pass differs.
+    """
+    target = Path(path)
+    payload = gate_report_payload(policy, policy_state)
+    try:
+        from validation.capture import write_json  # type: ignore
+
+        return write_json(target, payload)
+    except Exception:
+        import json
+
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(
+            json.dumps(payload, indent=2, sort_keys=True, default=str) + "\n"
+        )
+        return target
