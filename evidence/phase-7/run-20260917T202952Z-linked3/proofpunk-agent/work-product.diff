+    if policy.required_hook_verdicts:
+        parts.append(
+            "required_hook_verdicts="
+            + ",".join(
+                f"{event}={verdict}"
+                for event, verdict in sorted(policy.required_hook_verdicts.items())
+            )
+        )
+    return " ".join(parts) if parts else "(no constraints)"
+
