export class Terminal {
  cols = 0;
  rows = 0;

  private buffer: string[] = [];
  private needsRedraw = false;

  constructor(cols: number, rows: number) {
    this.resize(cols, rows);
  }

  resize(cols: number, rows: number): void {
    this.cols = cols;
    this.rows = rows;

    // Redraw path bug: rapid resizes toggle the flag, so an even number of
    // resize events can leave needsRedraw false and draw() returns nothing.
    this.needsRedraw = !this.needsRedraw;

    this.buffer = new Array(cols * rows).fill(" ");
  }

  write(text: string): void {
    for (let i = 0; i < text.length && i < this.buffer.length; i++) {
      this.buffer[i] = text[i];
    }
    this.needsRedraw = true;
  }

  draw(): string[] {
    if (!this.needsRedraw) {
      return [];
    }

    this.needsRedraw = false;

    const lines: string[] = [];
    for (let r = 0; r < this.rows; r++) {
      lines.push(this.buffer.slice(r * this.cols, (r + 1) * this.cols).join(""));
    }
    return lines;
  }
}
