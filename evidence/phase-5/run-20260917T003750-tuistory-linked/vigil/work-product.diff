+/**
+ * BudgetGuard — pure cumulative cost/turn tracking across session.result events.
+ *
+ * A session.result reports the total cost/turns for that plan's session; on
+ * repeat results for the same planId only the delta is counted, so cumulative
+ * spend equals the sum of per-plan session totals.
+ */
+
+export type BudgetMetric = "cost" | "turns";
+
+export interface BudgetSignal {
+  type: "warn" | "exceeded";
+  metric: BudgetMetric;
+  thresholdPct?: number; // warn only
+  spent: number;
+  cap: number;
+  message: string;
+}
+
+export interface BudgetGuardOpts {
+  maxBudgetUsd?: number;
+  maxTurns: number;
+  warnThresholds: number[]; // ascending percentages, e.g. [75, 90]
+}
+
+export interface SessionResultLike {
+  planId: string;
+  costUsd: number;
+  turns: number;
+}
+
+export class BudgetGuard {
+  private readonly opts: BudgetGuardOpts;
+  private readonly planCosts = new Map<string, number>();
+  private readonly planTurns = new Map<string, number>();
+  private readonly warned = { cost: new Set<number>(), turns: new Set<number>() };
+  private spentUsd = 0;
+  private spentTurns = 0;
+  private exceeded = false;
+
+  constructor(opts: BudgetGuardOpts) {
+    this.opts = opts;
+  }
+
+  /** Cumulative spend/turns so far. */
+  totals(): { spentUsd: number; spentTurns: number } {
+    return { spentUsd: this.spentUsd, spentTurns: this.spentTurns };
+  }
+
+  isExceeded(): boolean {
+    return this.exceeded;
+  }
+
+  /**
+   * Observe a session.result; returns warn signals (each threshold at most
+   * once per metric) and at most one exceeded signal when a cap is reached.
+   */
+  observe(result: SessionResultLike): BudgetSignal[] {
+    const prevCost = this.planCosts.get(result.planId) ?? 0;
+    const prevTurns = this.planTurns.get(result.planId) ?? 0;
+    const dCost = result.costUsd - prevCost;
+    const dTurns = result.turns - prevTurns;
+    if (dCost > 0) this.spentUsd += dCost;
+    if (dTurns > 0) this.spentTurns += dTurns;
+    this.planCosts.set(result.planId, result.costUsd);
+    this.planTurns.set(result.planId, result.turns);
+
+    const signals: BudgetSignal[] = [];
+
+    // cost checks inert when no cap configured
+    if (this.opts.maxBudgetUsd !== undefined) {
+      const pct = (this.spentUsd / this.opts.maxBudgetUsd) * 100;
+      if (pct >= 100) {
+        this.exceeded = true;
+        signals.push({
+          type: "exceeded",
+          metric: "cost",
+          spent: round2(this.spentUsd),
+          cap: this.opts.maxBudgetUsd,
+          message: `budget exceeded: $${round2(this.spentUsd).toFixed(2)} spent of $${this.opts.maxBudgetUsd.toFixed(2)} cap`,
+        });
+        return signals;
+      }
+      for (const t of this.opts.warnThresholds) {
+        if (pct >= t && !this.warned.cost.has(t)) {
+          this.warned.cost.add(t);
+          signals.push({
+            type: "warn",
+            metric: "cost",
+            thresholdPct: t,
+            spent: round2(this.spentUsd),
+            cap: this.opts.maxBudgetUsd,
+            message: `budget ${t}% — $${round2(this.spentUsd).toFixed(2)} of $${this.opts.maxBudgetUsd.toFixed(2)}`,
+          });
+        }
+      }
+    }
+
+    const tPct = (this.spentTurns / this.opts.maxTurns) * 100;
+    if (tPct >= 100) {
+      this.exceeded = true;
+      signals.push({
+        type: "exceeded",
+        metric: "turns",
+        spent: this.spentTurns,
+        cap: this.opts.maxTurns,
+        message: `turn budget exceeded: ${this.spentTurns} turns of ${this.opts.maxTurns}`,
+      });
+      return signals;
+    }
+    for (const t of this.opts.warnThresholds) {
+      if (tPct >= t && !this.warned.turns.has(t)) {
+        this.warned.turns.add(t);
+        signals.push({
+          type: "warn",
+          metric: "turns",
+          thresholdPct: t,
+          spent: this.spentTurns,
+          cap: this.opts.maxTurns,
+          message: `turns ${t}% — ${this.spentTurns} of ${this.opts.maxTurns}`,
+        });
+      }
+    }
+
+    return signals;
+  }
+}
+
+function round2(n: number): number {
+  return Math.round(n * 100) / 100;
+}
