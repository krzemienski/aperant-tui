+
+  it("budget.warn records a warn diag line and threshold; budget.exceeded an error line", () => {
+    let s = initialState();
+    s = reduce(s, { t: 1000, kind: "run.start", runId: "r", mode: "plan", label: "x", model: "m", cwd: "/w" });
+    s = reduce(s, { t: 2000, kind: "budget.warn", runId: "r", metric: "cost", thresholdPct: 75, spent: 1.5, cap: 2, message: "budget 75% — $1.50 of $2.00" });
+    s = reduce(s, { t: 2000, kind: "budget.warn", runId: "r", metric: "cost", thresholdPct: 75, spent: 1.5, cap: 2, message: "budget 75% — $1.50 of $2.00" });
+    s = reduce(s, { t: 3000, kind: "budget.exceeded", runId: "r", metric: "cost", spent: 2, cap: 2, message: "budget exceeded" });
+    expect(s.budgetWarned).toEqual([75]);
+    // both warn events log a diag line, but the threshold is deduped in state
+    expect(s.diag.filter((d) => d.level === "warn" && d.source === "budget")).toHaveLength(2);
+    expect(s.diag.some((d) => d.level === "error" && d.source === "budget" && d.text.includes("budget exceeded"))).toBe(true);
+  });
+});
