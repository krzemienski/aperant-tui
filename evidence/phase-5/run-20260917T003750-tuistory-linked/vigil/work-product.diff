+// ---------------------------------------------------------------------------
+// 1. Pure BudgetGuard: accumulation + warn thresholds fire exactly once
+// ---------------------------------------------------------------------------
+describe("BudgetGuard (pure)", () => {
+  it("accumulates cost across two plans and fires thresholds 75/90 exactly once each", () => {
+    const g = new BudgetGuard({ maxBudgetUsd: 1, maxTurns: 100, warnThresholds: [75, 90] });
+    expect(g.observe({ planId: "01", costUsd: 0.5, turns: 10 })).toEqual([]);
+    const s2 = g.observe({ planId: "02", costUsd: 0.3, turns: 10 }); // 80%
+    expect(s2).toHaveLength(1);
+    expect(s2[0]).toMatchObject({ type: "warn", metric: "cost", thresholdPct: 75, spent: 0.8 });
+    // repeat result for the same plan must NOT double-count
+    const dup = g.observe({ planId: "02", costUsd: 0.3, turns: 10 });
+    expect(dup).toEqual([]);
+    const s3 = g.observe({ planId: "03", costUsd: 0.2, turns: 10 }); // 100%
+    expect(s3).toEqual([{ type: "exceeded", metric: "cost", spent: 1, cap: 1, message: expect.stringContaining("budget exceeded") }]);
+    expect(g.isExceeded()).toBe(true);
+    expect(g.totals()).toEqual({ spentUsd: 1, spentTurns: 30 });
+  });
+
+  it("fires each threshold once even when a single result crosses several", () => {
+    const g = new BudgetGuard({ maxBudgetUsd: 10, maxTurns: 1000, warnThresholds: [75, 90] });
+    const s = g.observe({ planId: "01", costUsd: 8, turns: 1 }); // 80% → only 75
+    expect(s.map((x) => x.thresholdPct ?? x.type)).toEqual([75]);
+    const s2 = g.observe({ planId: "02", costUsd: 1, turns: 1 }); // 90%
+    expect(s2.map((x) => x.thresholdPct ?? x.type)).toEqual([90]);
+    const s3 = g.observe({ planId: "03", costUsd: 1, turns: 1 }); // 100%
+    expect(s3.map((x) => x.thresholdPct ?? x.type)).toEqual(["exceeded"]);
+  });
+
+  it("cost checks are inert when no maxBudgetUsd configured", () => {
+    const g = new BudgetGuard({ maxTurns: 100, warnThresholds: [75, 90] });
+    expect(g.observe({ planId: "01", costUsd: 999, turns: 1 })).toEqual([]);
+    expect(g.isExceeded()).toBe(false);
+  });
+
+  it("maxTurns enforced with the same warn-then-stop semantics", () => {
+    const g = new BudgetGuard({ maxBudgetUsd: 100, maxTurns: 10, warnThresholds: [75, 90] });
+    const s1 = g.observe({ planId: "01", costUsd: 0.01, turns: 8 }); // 80% of turns → warn 75
+    expect(s1).toEqual([expect.objectContaining({ type: "warn", metric: "turns", thresholdPct: 75 })]);
+    const s2 = g.observe({ planId: "02", costUsd: 0.01, turns: 3 }); // 11 turns → exceeded
+    expect(s2).toEqual([{ type: "exceeded", metric: "turns", spent: 11, cap: 10, message: expect.stringContaining("turn budget exceeded") }]);
+    expect(g.isExceeded()).toBe(true);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// 2–4. Runner enforcement via stubbed PlanSession
+// ---------------------------------------------------------------------------
+describe("Runner budget enforcement", () => {
+  it("halts sequencing after budget.exceeded, sets run.end reason, budgetExceeded", async () => {
+    const { runner, events, runsRoot } = await drive(
+      cfg({ maxBudgetUsd: 1, budgetWarnThresholds: [75, 90] }),
+      (planId, i) => ({ costUsd: [0.4, 0.5, 0.2][i], turns: 1 }), // cum 0.4, 0.9, 1.1
+    );
+    const kinds = events.map((e) => e.kind);
+    expect(kinds).toContain("budget.warn");
+    expect(kinds).toContain("budget.exceeded");
+    // no plan.start beyond the third plan (cap hit during plan 3)
+    const starts = events.filter((e) => e.kind === "plan.start");
+    expect(starts).toHaveLength(3);
+    expect(runner.budgetExceeded).toBe(true);
+    const end = events.find((e) => e.kind === "run.end") as Extract<RunEvent, { kind: "run.end" }>;
+    expect(end.reason).toBe("budget exceeded");
+    // warn thresholds 75 and 90 fired exactly once each (cum 0.9 = 90%)
+    const warns = events.filter((e) => e.kind === "budget.warn") as Extract<RunEvent, { kind: "budget.warn" }>[];
+    expect(warns.map((w) => w.thresholdPct)).toEqual([75, 90]);
+    // cost.json run-level total persisted
+    const costJson = JSON.parse(readFileSync(join(runsRoot, runner.store.runId, "cost.json"), "utf8"));
+    expect(costJson.totalCostUsd).toBeCloseTo(1.1, 5);
+    expect(costJson.totalTurns).toBe(3);
+  });
+
+  it("no maxBudgetUsd → no budget events, all plans run", async () => {
+    const { runner, events } = await drive(
+      cfg({}),
+      (planId, i) => ({ costUsd: 5 * (i + 1), turns: 1 }),
+    );
+    expect(events.filter((e) => e.kind.startsWith("budget."))).toEqual([]);
+    expect(events.filter((e) => e.kind === "plan.start")).toHaveLength(3);
+    expect(runner.budgetExceeded).toBe(false);
+    expect((events.find((e) => e.kind === "run.end") as Extract<RunEvent, { kind: "run.end" }>).reason).toBeUndefined();
+  });
+
+  it("maxTurns enforced: warn then stop with reason 'turns exceeded'", async () => {
+    const { runner, events } = await drive(
+      cfg({ maxBudgetUsd: 100, maxTurns: 10, budgetWarnThresholds: [75, 90] }),
+      (_planId, i) => ({ costUsd: 0.01, turns: 4 }), // cum turns 4, 8, 12 of 10
+    );
+    expect(events.some((e) => e.kind === "budget.warn" && (e as { metric: string }).metric === "turns")).toBe(true);
+    const ex = events.find((e) => e.kind === "budget.exceeded") as Extract<RunEvent, { kind: "budget.exceeded" }>;
+    expect(ex.metric).toBe("turns");
+    expect(events.filter((e) => e.kind === "plan.start")).toHaveLength(3);
+    expect(runner.budgetExceeded).toBe(true);
+    const end = events.find((e) => e.kind === "run.end") as Extract<RunEvent, { kind: "run.end" }>;
+    expect(end.reason).toBe("turns exceeded");
+  });
+});
