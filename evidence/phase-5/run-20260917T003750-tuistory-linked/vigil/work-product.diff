+// ---------------------------------------------------------------------------
+// 5. Reducer: cumulative spentUsd, budget.warn diag, header fields
+// ---------------------------------------------------------------------------
+describe("reducer budget state", () => {
+  const res = (planId: string, costUsd: number, turns: number): RunEvent =>
+    ({ t: 2000, kind: "session.result", planId, subtype: "success", costUsd, durationMs: 1, turns, usage: { input: 0, output: 0, cacheRead: 0, cacheCreate: 0 }, modelUsage: {} });
+
+  it("accumulates cumulative cost/turns across plans and repeated results", () => {
+    let s = initialState();
+    s = reduce(s, { t: 1000, kind: "run.start", runId: "r", mode: "plan", label: "x", model: "m", cwd: "/w", maxBudgetUsd: 2, maxTurns: 100 });
+    s = reduce(s, res("01", 0.5, 3));
