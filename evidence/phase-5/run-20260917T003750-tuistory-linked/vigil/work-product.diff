+import { join } from "node:path";
+import { BudgetGuard } from "../src/engine/budget.js";
+import { initialState, reduce } from "../src/state/reducer.js";
+import type { RunEvent } from "../src/engine/events.js";
+import type { VigilConfig } from "../src/config.js";
+import { ConfigSchema } from "../src/config.js";
+
+// ---------------------------------------------------------------------------
+// Stubbed PlanSession: emits a synthetic session.result and returns pass.
+// Each constructed session reports a configurable per-plan cost/turn total.
+// ---------------------------------------------------------------------------
+type SessionOpts = { planId: string };
+interface StubSession {
+  planId: string;
+  gateState: Map<string, string>;
+  interrupted: boolean;
+  on(ev: string, fn: (e: unknown) => void): unknown;
+  run(): Promise<{ verdict: "pass" | "fail" | "halted" }>;
+  interrupt(): Promise<void>;
+  close(): void;
+}
+
+const h = vi.hoisted(() => {
+  const instances: StubSession[] = [];
+  let nextReport: (planId: string, index: number) => { costUsd: number; turns: number } = () => ({ costUsd: 0, turns: 0 });
+  class StubSessionImpl {
+    planId: string;
+    gateState = new Map<string, string>();
+    listeners = new Map<string, Array<(e: unknown) => void>>();
+    interrupted = false;
+    constructor(opts: SessionOpts) { this.planId = opts.planId; instances.push(this as unknown as StubSession); }
+    on(ev: string, fn: (e: unknown) => void) { this.listeners.set(ev, [...(this.listeners.get(ev) ?? []), fn]); return this; }
+    emit(ev: string, payload: unknown) { for (const fn of this.listeners.get(ev) ?? []) fn(payload); }
+    async run() {
+      const idx = instances.indexOf(this as unknown as StubSession);
+      const { costUsd, turns } = nextReport(this.planId, idx);
+      this.emit("event", { t: Date.now(), kind: "session.result", planId: this.planId, subtype: "success", costUsd, durationMs: 10, turns, usage: { input: 0, output: 0, cacheRead: 0, cacheCreate: 0 }, modelUsage: {} });
+      return { verdict: "pass" as const };
+    }
+    async interrupt() { this.interrupted = true; }
+    close() { /* noop */ }
+  }
+  return { instances, setNextReport: (f: typeof nextReport) => { nextReport = f; }, StubSessionImpl };
+});
+
+vi.mock("../src/engine/session.js", () => ({ PlanSession: h.StubSessionImpl }));
+const instances = h.instances;
+
+import { Runner } from "../src/engine/runner.js";
+
+function cfg(over: Partial<VigilConfig> = {}): VigilConfig {
+  return ConfigSchema.parse({ probes: [], ...over });
+}
+
+function mkPlans(): string {
+  const root = mkdtempSync(join(tmpdir(), "vigil-budget-"));
+  for (const id of ["01-a", "02-b", "03-c"]) {
+    const dir = join(root, "phases", id);
+    mkdirSync(dir, { recursive: true });
+    writeFileSync(join(dir, `${id}-PLAN.md`), `# ${id}\n`);
+  }
+  return root;
+}
+
+async function drive(config: VigilConfig, report: (planId: string, i: number) => { costUsd: number; turns: number }) {
+  instances.length = 0;
+  h.setNextReport(report);
+  const target = mkPlans();
+  const runsRoot = mkdtempSync(join(tmpdir(), "vigil-runs-"));
+  const runner = new Runner({ config, mode: "plan", target, cwd: process.cwd(), approvals: "auto", runsRoot });
+  const events: RunEvent[] = [];
+  runner.on("event", (e: RunEvent) => events.push(e));
+  const ok = await runner.start();
+  return { runner, events, ok, runsRoot };
+}
+
+beforeEach(() => { instances.length = 0; });
