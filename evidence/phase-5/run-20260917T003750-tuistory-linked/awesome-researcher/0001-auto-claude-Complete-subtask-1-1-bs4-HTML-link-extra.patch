     return t
 
 
+def _extract_html_links(line: str) -> list[tuple[str, str, str | None]]:
+    """Extract resource links from a line containing inline HTML.
+
+    Uses BeautifulSoup (``html.parser``) lazily so environments without bs4
+    degrade to the regex-only behavior. Returns ``(title, url, description)``
+    tuples for each ``<a href="http(s)://...">`` anchor found. The anchor text
+    becomes the title; a trailing text node after a separator (``-``, ``—``,
+    ``:``) becomes the description when present.
+    """
+
+    try:
+        from bs4 import BeautifulSoup  # lazy: optional dependency
+    except ImportError:
+        return []
+
+    links: list[tuple[str, str, str | None]] = []
+    try:
+        soup = BeautifulSoup(line, "html.parser")
+    except Exception:
+        return []
+
+    for anchor in soup.find_all("a", href=True):
+        url = (anchor.get("href") or "").strip()
+        if not _is_resource_url(url):
+            continue
+        title = _clean_title(anchor.get_text())
+        description: str | None = None
+        # Text after the anchor on the same line may hold a description
+        # (" - Description" / " — Description" / ": Description").
+        tail = ""
+        node = anchor.next_sibling
+        while node is not None:
+            if getattr(node, "name", None) is None:
+                tail += str(node)
+            node = node.next_sibling
+        m = re.match(r"\s*[-—:]\s*(.*\S)", tail)
+        if m:
+            description = m.group(1).strip()
+        links.append((title or url, url, description))
+    return links
+
