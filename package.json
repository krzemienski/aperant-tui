{
  "name": "aperant-tui-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Aperant TUI — Ink/React terminal renderer over the Aperant TypeScript agent runtime",
  "workspaces": [
    "apps/tui",
    "libs/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aperant/tui",
    "build": "npm run build -w @aperant/tui",
    "start": "npm run start -w @aperant/tui",
    "test": "npm test -w @aperant/tui",
    "typecheck": "npm run typecheck -w @aperant/tui"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.54",
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/azure": "^4.0.41",
    "@ai-sdk/google": "^4.0.42",
    "@ai-sdk/groq": "^4.0.28",
    "@ai-sdk/mcp": "^2.0.31",
    "@ai-sdk/mistral": "^4.0.29",
    "@ai-sdk/openai": "^4.0.40",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/xai": "^4.0.36",
    "@anthropic-ai/sdk": "^0.116.0",
    "@aperant/moonshot-provider": "file:libs/moonshot-provider",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tavily/core": "^0.7.7",
    "ai": "^7.0.62",
    "react-devtools-core": "^4.28.5",
    "zod": "^4.4.3"
  }
}
