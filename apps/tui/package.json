{
  "name": "@aperant/tui",
  "version": "0.1.0",
  "description": "Aperant terminal UI \u2014 Ink/React renderer over the Aperant TypeScript agent runtime",
  "type": "module",
  "bin": {
    "aperant": "./bin/aperant.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "node ../../tools/build-worker.mjs && node ../../tools/build-cli.mjs",
    "start": "node dist/cli.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.54",
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/azure": "^4.0.41",
    "@ai-sdk/google": "^4.0.42",
    "@ai-sdk/groq": "^4.0.28",
    "@ai-sdk/mcp": "^2.0.31",
    "@ai-sdk/mistral": "^4.0.29",
    "@ai-sdk/openai": "^4.0.40",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/xai": "^4.0.36",
    "@anthropic-ai/sdk": "^0.116.0",
    "@aperant/moonshot-provider": "file:../../libs/moonshot-provider",
    "@libsql/client": "^0.17.4",
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@sentry/electron": "file:../../libs/sentry-adapter",
    "@tavily/core": "^0.7.7",
    "@xterm/headless": "^6.0.0",
    "ai": "^7.0.62",
    "electron": "file:../../libs/electron-shim",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "uuid": "^11.0.0",
    "xstate": "^5.19.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
