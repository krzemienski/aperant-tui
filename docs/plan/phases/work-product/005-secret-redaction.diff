new file mode 100644
index 0000000..d22cb30
--- /dev/null
+++ b/src/engine/redact.ts
@@ -0,0 +1,257 @@
+/**
+ * Redactor — replaces secrets with a stable, non-recoverable placeholder.
+ *
+ * Run artifacts (events.jsonl, tools/*.txt, gates.json, cost.json) are kept
+ * forever and are meant to be shared with auditors, so anything that looks like
+ * a credential must never reach disk. A secret becomes `[redacted:<8 hex>]`
+ * where the hex is the sha256 prefix of the secret: two different secrets stay
+ * distinguishable across a run, but neither is recoverable from the artifact.
+ *
+ * Throughput matters — this sits on the hot write path of every run — so all
+ * literals, built-ins and user patterns are compiled into ONE global RegExp and
+ * each string is scanned in a single pass, with secret -> placeholder memoised.
+ */
+import { createHash } from "node:crypto";
+import type { RunEvent } from "./events.js";
+
+export interface RedactPattern {
+  /** stable id, used in docs/tests to name the shape this pattern covers */
+  id: string;
+  /** regex source; an optional capture group marks the secret portion of the match */
+  source: string;
+}
+
+export interface RedactorOptions {
+  /** exact strings always redacted (e.g. the resolved auth token) */
+  literals?: string[];
+  /** extra user regex sources from config.redact */
+  patterns?: string[];
+  /** include BUILTIN_REDACT_PATTERNS (default: true) */
+  builtins?: boolean;
+}
+
+/**
+ * Only plain JSON-ish containers are walked. Everything a RunEvent carries is
+ * JSON (it is JSON.stringify'd straight to events.jsonl), so an exotic object
+ * would not survive serialisation anyway — it is returned untouched rather than
+ * silently flattened into a plain object.
+ */
+function isPlainObject(v: object): boolean {
+  const p = Object.getPrototypeOf(v) as unknown;
+  return p === Object.prototype || p === null;
+}
+
+/** Escape a literal so it can be embedded in a RegExp source. */
+function escapeRegExp(s: string): string {
+  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
+
+/**
+ * Case-insensitive source for a literal word. JS has no inline (?i), and the
+ * combined regex must stay case-SENSITIVE (so `AKIA…` does not match lowercase
+ * prose), so per-word insensitivity is spelled out as character classes.
+ */
+function anyCase(word: string): string {
+  return word.replace(/[A-Za-z]/g, (c) => `[${c.toUpperCase()}${c.toLowerCase()}]`);
+}
+
+/**
+ * Names that make a `NAME=value` assignment secret-bearing. The keyword must
+ * start the name, follow a `_`, or be CamelCase — so `API_KEY`, `key`, `apiKey`
+ * match while `monkey`, `PATH` and `NODE_ENV` do not.
+ */
+const SECRET_NAME_KEYWORD = "(?:TOKEN|SECRET|PASSWORD|PASSWD|KEY|token|secret|password|passwd|key)";
+/** CamelCase keyword — the capital is what separates `apiKey` from `monkey`. */
+const SECRET_NAME_KEYWORD_CAMEL = "(?:Token|Secret|Password|Passwd|Key)";
+/** `MY_`, `DB_`, `aws_iam_` … each segment ends in `_` and cannot contain one, so there is no ambiguity to backtrack over. */
+const SECRET_NAME =
+  `(?:[A-Za-z0-9.-]+_)*(?:${SECRET_NAME_KEYWORD}|[A-Za-z0-9]*${SECRET_NAME_KEYWORD_CAMEL})[A-Za-z0-9_.-]*`;
+/** double-quoted | single-quoted | bare; a bare value stops at whitespace, a quote or a shell/JSON terminator. */
+const ASSIGNED_VALUE = "(?:\"([^\"\\n]*)\"|'([^'\\n]*)'|([^\\s\"'`,;)}]+))";
+
+/**
+ * Built-in shapes, tried in this order when two match at the same offset.
+ * Where a prefix must stay readable (`Authorization: `, `API_KEY=`) only the
+ * capture group is replaced, so the artifact still shows what was there.
+ */
+export const BUILTIN_REDACT_PATTERNS: RedactPattern[] = [
+  {
+    // whole PEM block, first so an inner line is never matched on its own
+    id: "pem-private-key",
+    source: "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
+  },
+  {
+    // Authorization: Bearer <cred> / "authorization": "<cred>" / Authorization=<cred>
+    id: "authorization-header",
+    source:
+      `["']?${anyCase("authorization")}["']?\\s*[:=]\\s*["']?` +
+      `(?:(?:${anyCase("bearer")}|${anyCase("basic")}|${anyCase("token")})\\s+)?([^\\s"',;}]+)`,
+  },
+  {
+    // a bare `Bearer <token>` with no header name; long enough not to hit prose
+    id: "bearer-token",
+    source: `\\b${anyCase("bearer")}\\s+([A-Za-z0-9._~+/=-]{16,})`,
+  },
+  {
+    id: "aws-secret-access-key",
+    source: `["']?${anyCase("aws_secret_access_key")}["']?\\s*[:=]\\s*["']?([A-Za-z0-9/+=]{40})`,
+  },
+  {
+    id: "aws-access-key-id",
+    source: "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
+  },
+  {
+    // sk-…, sk-ant-…, and friends
+    id: "openai-style-key",
+    source: "\\bsk-[A-Za-z0-9_-]{16,}",
+  },
+  {
+    // NAME=value / NAME = value / export NAME=value / "name": "value"
+    id: "env-assignment",
+    source: `(?<![A-Za-z0-9_])(?:${anyCase("export")}\\s+)?["']?${SECRET_NAME}["']?\\s*[:=]\\s*${ASSIGNED_VALUE}`,
+  },
+];
+
+/** `[redacted:<first 8 hex of sha256(secret)>]` — stable within and across runs. */
+export function placeholder(secret: string): string {
+  return `[redacted:${createHash("sha256").update(secret).digest("hex").slice(0, 8)}]`;
+}
+
+export class Redactor {
+  /** null when there is nothing to match — redact() then returns its input untouched. */
+  private readonly re: RegExp | null;
+  private readonly cache = new Map<string, string>();
+
+  constructor(opts: RedactorOptions = {}) {
+    const parts: string[] = [];
+
+    // literals first: an exact known secret wins over any pattern at the same offset.
+    // longest first so a token that contains another token is redacted whole.
+    const literals = [...new Set((opts.literals ?? []).filter((l) => typeof l === "string" && l.trim() !== ""))].sort(
+      (a, b) => b.length - a.length,
+    );
+    for (const lit of literals) parts.push(`(?:${escapeRegExp(lit)})`);
+
+    if (opts.builtins !== false) for (const p of BUILTIN_REDACT_PATTERNS) parts.push(`(?:${p.source})`);
+
+    for (const src of opts.patterns ?? []) {
+      if (typeof src !== "string" || src.trim() === "") continue;
+      try {
+        new RegExp(src);
+      } catch (e) {
+        throw new Error(`redact: invalid regular expression /${src}/ — ${(e as Error).message}`);
+      }
+      // wrapped so a top-level `|` stays scoped; a user capture group marks the
+      // secret portion (backreferences are not supported — groups are renumbered).
+      parts.push(`(?:${src})`);
+    }
+
+    this.re = parts.length ? new RegExp(parts.join("|"), "gd") : null;
+  }
+
+  /** Replace every match in `text`. Returns the same string when nothing matched. */
+  redact(text: string): string {
+    const re = this.re;
+    if (re === null || text.length === 0) return text;
+    re.lastIndex = 0;
+    let out = "";
+    let last = 0;
+    let m: RegExpExecArray | null;
+    while ((m = re.exec(text)) !== null) {
+      if (m[0].length === 0) {
+        re.lastIndex++; // zero-length match: never allowed to spin
+        continue;
+      }
+      const [start, end] = this.secretSpan(m);
+      const secret = text.slice(start, end);
+      if (secret.trim() === "") continue; // e.g. API_KEY="" — nothing to hide
+      out += text.slice(last, start) + this.placeholderFor(secret);
+      last = end;
+    }
+    if (last === 0) return text; // fast path: allocate nothing when clean
+    return out + text.slice(last);
+  }
+
+  /**
+   * Deep-redact a RunEvent: a structurally identical copy with every string —
+   * and every object KEY, since a parsed .env object can carry a secret as a
+   * key — passed through redact().
+   *
+   * The walk is generic rather than a per-kind switch, so every current variant
+   * (tool.start.input, tool.output.chunk, tool.end.output, assistant.text/delta,
+   * log.message, hook.reason, gate.update.reason, control.detail,
+   * approval.request.input) and every future one is covered automatically.
+   *
+   * Never mutates its argument — the UI holds the original — and returns the
+   * SAME reference when nothing changed, so a clean event allocates nothing.
+   */
+  redactEvent<T extends RunEvent>(ev: T): T {
+    if (this.re === null) return ev;
+    return this.redactValue(ev) as T;
+  }
+
+  /** Non-mutating copy-on-change walk over any JSON-ish value. */
+  private redactValue(v: unknown): unknown {
+    if (typeof v === "string") return this.redact(v);
+    if (v === null || typeof v !== "object") return v; // number/boolean/undefined/bigint/fn
+
+    if (Array.isArray(v)) {
+      let out: unknown[] | null = null;
+      for (let i = 0; i < v.length; i++) {
+        const before: unknown = v[i];
+        const after = this.redactValue(before);
+        if (out === null) {
+          if (after === before) continue;
+          out = v.slice(0, i); // copy the clean prefix once, on first change
+        }
+        out.push(after);
+      }
+      return out ?? v;
+    }
+
+    if (!isPlainObject(v)) return v;
+
+    const src = v as Record<string, unknown>;
+    const keys = Object.keys(src);
+    let out: Record<string, unknown> | null = null;
+    for (let i = 0; i < keys.length; i++) {
+      const key = keys[i]!;
+      const before: unknown = src[key];
+      const after = this.redactValue(before);
+      const redKey = this.redact(key); // identity-equal when clean
+      if (out === null) {
+        if (after === before && redKey === key) continue;
+        out = {};
+        for (let j = 0; j < i; j++) out[keys[j]!] = src[keys[j]!]; // clean prefix, order preserved
+      }
+      // two keys can collapse onto one placeholder (same secret twice); last wins,
+      // which is acceptable — the artifact must be safe, not round-trippable.
+      out[redKey] = after;
+    }
+    return out ?? v;
+  }
+
+  /** The span to replace: the first participating capture group, else the whole match. */
+  private secretSpan(m: RegExpExecArray): [number, number] {
+    for (let i = 1; i < m.length; i++) {
+      const g = m[i];
+      if (g === undefined) continue;
+      const span = m.indices?.[i];
+      if (span) return [span[0], span[1]];
+      // no `d` flag support: the secret is the tail of the match in every built-in
+      const at = m[0].lastIndexOf(g);
+      if (at >= 0) return [m.index + at, m.index + at + g.length];
+      break;
+    }
+    return [m.index, m.index + m[0].length];
+  }
+
+  private placeholderFor(secret: string): string {
+    let p = this.cache.get(secret);
+    if (p === undefined) {
+      p = placeholder(secret);
+      this.cache.set(secret, p);
+    }
+    return p;
+  }
+}
