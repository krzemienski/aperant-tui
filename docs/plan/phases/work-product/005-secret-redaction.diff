@@ -0,0 +1,268 @@
+import { describe, it, expect } from "vitest";
+import { Redactor, BUILTIN_REDACT_PATTERNS, placeholder } from "../src/engine/redact.js";
+import type { RunEvent } from "../src/engine/events.js";
+
+const PLACEHOLDER = /^\[redacted:[0-9a-f]{8}\]$/;
+/** the same shape, unanchored, for asserting inside a longer string */
+const PLACEHOLDER_IN = /\[redacted:[0-9a-f]{8}\]/;
+
+const r = new Redactor({});
+
+const PEM = [
+  "-----BEGIN RSA PRIVATE KEY-----",
+  "MIIEowIBAAKCAQEAxq7Bf3s0nOaVbGgqEXAMPLEKEYMATERIALnotarealkey0000",
+  "Zm9vYmFyYmF6cXV1eA==",
+  "-----END RSA PRIVATE KEY-----",
+].join("\n");
+
+describe("built-in secret shapes", () => {
+  it("redacts an sk- prefixed api key", () => {
+    const out = r.redact("using sk-abcdefghijklmnop0123456789 now");
+    expect(out).not.toContain("sk-abcdefghijklmnop0123456789");
+    expect(out).toMatch(/^using \[redacted:[0-9a-f]{8}\] now$/);
+  });
+
+  it("redacts an Authorization: Bearer header but keeps the prefix readable", () => {
+    const tok = "abcdefghijklmnopqrstuvwxyz012345";
+    const out = r.redact(`Authorization: Bearer ${tok}`);
+    expect(out).not.toContain(tok);
+    expect(out).toMatch(/^Authorization: Bearer \[redacted:[0-9a-f]{8}\]$/);
+  });
+
+  it("redacts the JSON form of an authorization header", () => {
+    const tok = "abc123def456ghi789";
+    const out = r.redact(`{"authorization": "Bearer ${tok}"}`);
+    expect(out).not.toContain(tok);
+    expect(out).toMatch(PLACEHOLDER_IN);
+  });
+
+  it("redacts AWS access key ids (AKIA and ASIA)", () => {
+    const out = r.redact("AKIAIOSFODNN7EXAMPLE and ASIAIOSFODNN7EXAMPLE");
+    expect(out).not.toContain("AKIAIOSFODNN7EXAMPLE");
+    expect(out).not.toContain("ASIAIOSFODNN7EXAMPLE");
+    expect(out).toMatch(/^\[redacted:[0-9a-f]{8}\] and \[redacted:[0-9a-f]{8}\]$/);
+  });
+
+  it("redacts an aws_secret_access_key assignment in both cases", () => {
+    const sec = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
+    for (const line of [`aws_secret_access_key = ${sec}`, `AWS_SECRET_ACCESS_KEY=${sec}`]) {
+      const out = r.redact(line);
+      expect(out).not.toContain(sec);
+      expect(out).toMatch(PLACEHOLDER_IN);
+    }
+  });
+
+  it("redacts a whole PEM private key block", () => {
+    const out = r.redact(`before\n${PEM}\nafter`);
+    expect(out).not.toContain("MIIEowIBAAKCAQEA");
+    expect(out).not.toContain("BEGIN RSA PRIVATE KEY");
+    expect(out).toMatch(/^before\n\[redacted:[0-9a-f]{8}\]\nafter$/);
+  });
+
+  it("redacts KEY=value assignments whose name looks secret-bearing", () => {
+    const cases: [string, string][] = [
+      ["MY_TOKEN=abc123secretvalue", "abc123secretvalue"],
+      ["DB_PASSWORD = 's3cr3tpw'", "s3cr3tpw"],
+      ['export API_KEY="ak-live-0123456789abcdef"', "ak-live-0123456789abcdef"],
+      ["CLIENT_SECRET=zzz-top-secret", "zzz-top-secret"],
+    ];
+    for (const [line, secret] of cases) {
+      const out = r.redact(line);
+      expect(out, `expected ${line} to be redacted`).not.toContain(secret);
+      expect(out).toMatch(PLACEHOLDER_IN);
+    }
+  });
+
+  it("exposes the built-in patterns as compilable sources", () => {
+    expect(BUILTIN_REDACT_PATTERNS.length).toBeGreaterThan(0);
+    for (const p of BUILTIN_REDACT_PATTERNS) {
+      expect(p.id).toBeTruthy();
+      expect(() => new RegExp(p.source)).not.toThrow();
+    }
+  });
+});
+
+describe("placeholder", () => {
+  it("has the [redacted:<8 hex>] shape", () => {
+    expect(placeholder("anything")).toMatch(PLACEHOLDER);
+  });
+
+  it("is stable: the same secret yields the same hash twice", () => {
+    expect(placeholder("sk-abcdefghijklmnop0123456789")).toBe(placeholder("sk-abcdefghijklmnop0123456789"));
+    const a = r.redact("sk-abcdefghijklmnop0123456789");
+    const b = r.redact("sk-abcdefghijklmnop0123456789");
+    expect(a).toBe(b);
+  });
+
+  it("keeps two different secrets distinguishable", () => {
+    const a = placeholder("sk-aaaaaaaaaaaaaaaa0000000000");
+    const b = placeholder("sk-bbbbbbbbbbbbbbbb1111111111");
+    expect(a).not.toBe(b);
+    const out = r.redact("sk-aaaaaaaaaaaaaaaa0000000000 then sk-bbbbbbbbbbbbbbbb1111111111");
+    const hits = out.match(/\[redacted:[0-9a-f]{8}\]/g) ?? [];
+    expect(hits).toHaveLength(2);
+    expect(hits[0]).not.toBe(hits[1]);
+  });
+});
+
+describe("no false positives", () => {
+  it("leaves ordinary text untouched", () => {
+    const clean = [
+      "echo hi",
+      "PATH=/usr/bin",
+      "NODE_ENV=production",
+      "npm run build",
+      "monkey=banana",
+      "the donkey=grey",
+      "HOME=/Users/nick",
+      "sk-short",
+      "git commit -m 'fix the key handling'",
+    ];
+    for (const s of clean) expect(r.redact(s), `expected ${s} to be left alone`).toBe(s);
+  });
+
+  it("returns the identical string reference when nothing matched", () => {
+    const s = "nothing secret here at all";
+    expect(r.redact(s)).toBe(s);
+  });
+
+  it("does not redact an empty assigned value", () => {
+    expect(r.redact('API_KEY=""')).toBe('API_KEY=""');
+  });
+});
+
+describe("user patterns and literals", () => {
+  it("applies extra user-supplied patterns", () => {
+    const u = new Redactor({ patterns: ["my-internal-[a-z0-9]{12}"] });
+    const out = u.redact("id my-internal-a1b2c3d4e5f6 ok");
+    expect(out).not.toContain("my-internal-a1b2c3d4e5f6");
+    expect(out).toMatch(PLACEHOLDER_IN);
+  });
+
+  it("throws a clear error for an invalid user pattern", () => {
+    expect(() => new Redactor({ patterns: ["([unclosed"] })).toThrow(/invalid regular expression/);
+  });
+
+  it("redacts literals by exact match even when no pattern would match them", () => {
+    expect(r.redact("password is hunter2 ok")).toBe("password is hunter2 ok"); // no pattern covers it
+    const l = new Redactor({ literals: ["hunter2"] });
+    const out = l.redact("password is hunter2 ok");
+    expect(out).not.toContain("hunter2");
+    expect(out).toBe(`password is ${placeholder("hunter2")} ok`);
+  });
+
+  it("treats literals as text, not regex", () => {
+    const l = new Redactor({ literals: ["a.c+d"], builtins: false });
+    expect(l.redact("abcxd")).toBe("abcxd");
+    expect(l.redact("a.c+d")).toBe(placeholder("a.c+d"));
+  });
+
+  it("ignores empty and whitespace-only literals", () => {
+    const l = new Redactor({ literals: ["", "   "], builtins: false });
+    expect(l.redact("perfectly ordinary text")).toBe("perfectly ordinary text");
+  });
+
+  it("is a pass-through when there is nothing to match", () => {
+    const p = new Redactor({ builtins: false });
+    const s = "MY_TOKEN=abc123secretvalue";
+    expect(p.redact(s)).toBe(s);
+  });
+});
+
+describe("redactEvent", () => {
+  const tok = "abcdefghijklmnopqrstuvwxyz012345";
+
+  const nested = (): Extract<RunEvent, { kind: "tool.start" }> => ({
+    t: 1,
+    kind: "tool.start",
+    planId: "p",
+    toolUseId: "tu1",
+    name: "Bash",
+    input: {
+      command: `curl -H 'Authorization: Bearer ${tok}' https://api.example.com`,
+      env: { API_KEY: "sk-abcdefghijklmnop0123456789", NODE_ENV: "production" },
+      args: ["--retry", 3, true, null, "MY_TOKEN=abc123secretvalue"],
+      timeoutMs: 5000,
+      quiet: false,
+      parent: null,
+    },
+    parentToolUseId: null,
+  });
+
+  it("deep-redacts a nested tool.start input", () => {
+    const out = r.redactEvent(nested());
+    const json = JSON.stringify(out);
+    expect(json).not.toContain(tok);
+    expect(json).not.toContain("sk-abcdefghijklmnop0123456789");
+    expect(json).not.toContain("abc123secretvalue");
+    expect(json).toMatch(PLACEHOLDER_IN);
+  });
+
+  it("leaves numbers, booleans and nulls intact", () => {
+    const out = r.redactEvent(nested());
+    const input = out.input as { args: unknown[]; timeoutMs: number; quiet: boolean; parent: null; env: Record<string, string> };
+    expect(input.args[1]).toBe(3);
+    expect(input.args[2]).toBe(true);
+    expect(input.args[3]).toBeNull();
+    expect(input.timeoutMs).toBe(5000);
+    expect(input.quiet).toBe(false);
+    expect(input.parent).toBeNull();
+    expect(input.env.NODE_ENV).toBe("production");
+    expect(out.t).toBe(1);
+    expect(out.kind).toBe("tool.start");
+    expect(out.name).toBe("Bash");
+    expect(out.parentToolUseId).toBeNull();
+  });
+
+  it("does not mutate its argument", () => {
+    const ev = nested();
+    const before = JSON.stringify(ev);
+    r.redactEvent(ev);
+    expect(JSON.stringify(ev)).toBe(before);
+  });
+
+  it("redacts secrets that appear as object keys", () => {
+    const ev: RunEvent = {
+      t: 1,
+      kind: "tool.start",
+      planId: "p",
+      toolUseId: "tu1",
+      name: "Read",
+      input: { parsedEnv: { "sk-abcdefghijklmnop0123456789": "value" } },
+      parentToolUseId: null,
+    };
+    const json = JSON.stringify(r.redactEvent(ev));
+    expect(json).not.toContain("sk-abcdefghijklmnop0123456789");
+    expect(json).toMatch(PLACEHOLDER_IN);
+  });
+
+  it("covers every string-bearing event kind generically", () => {
+    const evs: RunEvent[] = [
+      { t: 1, kind: "tool.output", planId: "p", toolUseId: "tu1", chunk: `Authorization: Bearer ${tok}\n` },
+      { t: 1, kind: "tool.end", planId: "p", toolUseId: "tu1", ok: true, durationMs: 1, output: `Authorization: Bearer ${tok}` },
+      { t: 1, kind: "assistant.text", planId: "p", text: `use Bearer ${tok}`, parentToolUseId: null, final: true },
+      { t: 1, kind: "assistant.delta", planId: "p", text: `use Bearer ${tok}`, parentToolUseId: null },
+      { t: 1, kind: "log", level: "info", source: "s", message: `Authorization: Bearer ${tok}` },
+      { t: 1, kind: "hook", planId: "p", event: "PreToolUse", decision: "warn", reason: `Authorization: Bearer ${tok}`, latencyMs: 1 },
+      { t: 1, kind: "gate.update", planId: "p", gateId: "VG-1", verdict: "fail", reason: `Authorization: Bearer ${tok}` },
+      { t: 1, kind: "control", action: "inject", detail: `Authorization: Bearer ${tok}` },
+      { t: 1, kind: "approval.request", planId: "p", requestId: "r1", tool: "Bash", input: { cmd: `Authorization: Bearer ${tok}` } },
+    ];
+    for (const ev of evs) {
